# MoySklad API
TOKEN=

# App
PASSCODE=1990
PORT=3000
SESSION_SECRET=
ANTHROPIC_API_KEY=

# Tally / MongoDB (unrelated to the MoySklad Postgres module — leave as-is)
MONGODB_URI=
MONGODB_DB_NAME=tally_sync
TALLY_URL=http://localhost:9000

# MoySklad Postgres module
# Connection string for the Postgres database the MoySklad module syncs into.
DATABASE_URL=
# 'live' (default) reads MoySklad data straight from the API, same as before.
# 'postgres' reads from the synced database instead — only switch this once
# db/migrate.js + sync/ms-backfill.js have been run and the data looks right.
MS_DATA_SOURCE=live
# How often the background sync re-fetches from MoySklad, in minutes.
MS_SYNC_INTERVAL_MINUTES=5
# Set to 'false' to fully stop the background sync (e.g. freezing data at a
# cutover point without needing to blank out TOKEN). Defaults to enabled.
MS_SYNC_ENABLED=true
# Close date of a retired MoySklad account (e.g. "2026-08-31"). When set,
# every orders/demands sync caps moment<= this date, so if you ever need to
# temporarily flip MS_SYNC_ENABLED back on to pull in a late correction made
# in the old account, it's impossible for that catch-up to leak data past
# the cutover. Leave blank when not applicable.
MS_SYNC_1_CLOSE_DATE=
# Historical backfill start date (matches the dashboard's existing charts).
MS_SYNC_FROM=2024-12-01
