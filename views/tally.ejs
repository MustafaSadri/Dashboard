<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main">
  <%- include('partials/header', {pageTitle: 'Tally Dashboard'}) %>
  <div class="page">

  <%
    var daysSince = function(ds) {
      if (!ds) return null;
      return Math.floor((Date.now() - new Date(ds).getTime()) / 86400000);
    };
    var selMonthLabel = (function(){
      var d = new Date(selMonth + '-02');
      return d.toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
    })();
    var grossProfit = periodSales - periodPurchases;
    var ytdProfit   = totalSales - totalPurchases - totalExpenses;
    var grossMargin = periodSales > 0 ? Math.round(grossProfit / periodSales * 100) : 0;
  %>

  <!-- ══ CONNECTION + FILTER + SYNC ══════════════════════════ -->
  <div class="card" style="margin-bottom:20px;padding:12px 18px">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">

      <% if(!connected){ %>
      <% if(syncedAt){ %>
      <div style="font-size:12px;color:var(--text2)">
        <i class="fas fa-database" style="margin-right:5px;opacity:.6"></i>Last synced: <%= new Date(syncedAt).toLocaleString('en-IN') %>
      </div>
      <% } %>
      <% } else { %>
      <div style="display:flex;align-items:center;gap:7px;color:var(--accent2);font-size:13px">
        <i class="fas fa-circle-check"></i>
        <span>Connected<% if(company){ %> · <strong style="color:var(--text)"><%- company %></strong><% } %></span>
        <% if(syncedAt){ %><span style="color:var(--text2);font-size:12px">· synced <%= new Date(syncedAt).toLocaleString('en-IN') %></span><% } %>
      </div>
      <% } %>

      <div style="margin-left:auto;display:flex;align-items:center;gap:9px;flex-wrap:wrap">
        <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text2)">
          <i class="fas fa-calendar-days" style="font-size:11px"></i>
          <select onchange="window.location='/tally?month='+this.value"
            style="background:var(--bg3);border:1px solid var(--border);color:var(--text);border-radius:7px;padding:5px 10px;font-size:12px;cursor:pointer;outline:none">
            <% monthOpts.forEach(function(m){ %>
            <option value="<%- m.value %>" <%- m.value===selMonth?'selected':'' %>><%- m.label %></option>
            <% }) %>
          </select>
        </div>
        <% if(connected){ %>
        <button id="syncBtn" onclick="syncNow()"
          style="display:flex;align-items:center;gap:6px;padding:6px 14px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer">
          <i class="fas fa-cloud-arrow-up" id="syncIcon"></i><span id="syncText">Sync to DB</span>
        </button>
        <% } %>
        <a href="/tally?month=<%- selMonth %>" class="topbar-refresh" title="Refresh"><i class="fas fa-rotate-right"></i></a>
      </div>
    </div>

    <% if(!hasDbData){ %>
    <div style="margin-top:10px;padding:9px 13px;background:rgba(255,169,77,.08);border:1px solid rgba(255,169,77,.25);border-radius:8px;font-size:12px;color:var(--warn)">
      <i class="fas fa-triangle-exclamation" style="margin-right:5px"></i>
      No historical data yet — run
      <code style="background:var(--bg3);padding:2px 6px;border-radius:4px;font-size:11px">node sync-tally-full.js</code>
      once to load full history. Then use Sync daily.
    </div>
    <% } else if(periodVouchers.length===0 && monthsWithData.length>0){ %>
    <div style="margin-top:10px;padding:9px 13px;background:rgba(136,145,181,.07);border:1px solid var(--border);border-radius:8px;font-size:12px;color:var(--text2)">
      <i class="fas fa-calendar-xmark" style="margin-right:5px"></i>
      No Tally data for <strong><%- selMonthLabel %></strong>.
      Data available for:
      <% monthsWithData.slice(-6).forEach(function(m,i){ var d=new Date(m+'-02'); %>
        <% if(i>0){ %>,<% } %>
        <a href="/tally?month=<%- m %>" style="color:var(--accent);text-decoration:none;font-weight:600"><%= d.toLocaleDateString('en-IN',{month:'short',year:'numeric'}) %></a>
      <% }) %>
      <% if(monthsWithData.length>6){ %> <span style="opacity:.6">+ <%- monthsWithData.length-6 %> more</span><% } %>
    </div>
    <% } %>
  </div>

  <!-- ══ PERIOD KPI CARDS ════════════════════════════════════ -->
  <div style="font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.8px;font-weight:600;margin-bottom:8px">
    <i class="fas fa-calendar-check" style="color:var(--accent);margin-right:5px"></i><%- selMonthLabel %>
  </div>
  <div class="stats-grid" style="grid-template-columns:repeat(6,1fr);margin-bottom:20px">
    <div class="stat-card success">
      <div class="stat-label">Sales</div>
      <div class="stat-value"><%- fmtShort(periodSales) %></div>
      <div class="stat-sub">Revenue</div>
      <i class="fas fa-arrow-trend-up stat-icon"></i>
    </div>
    <div class="stat-card warn">
      <div class="stat-label">Purchases</div>
      <div class="stat-value"><%- fmtShort(periodPurchases) %></div>
      <div class="stat-sub">COGS</div>
      <i class="fas fa-cart-flatbed stat-icon"></i>
    </div>
    <div class="stat-card <%- grossProfit>=0?'success':'danger' %>">
      <div class="stat-label">Gross Profit</div>
      <div class="stat-value"><%- fmtShort(Math.abs(grossProfit)) %></div>
      <div class="stat-sub">Margin <%- grossMargin %>%</div>
      <i class="fas fa-chart-pie stat-icon"></i>
    </div>
    <div class="stat-card" onclick="document.getElementById('voucherSection').scrollIntoView({behavior:'smooth'});setTimeout(function(){filterV('receipt');},400);" style="cursor:pointer" title="Click to view collection entries">
      <div class="stat-label">Collections <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;opacity:.5;margin-left:3px"></i></div>
      <div class="stat-value"><%- fmtShort(periodCollections) %></div>
      <div class="stat-sub">Money received this month</div>
      <i class="fas fa-hand-holding-dollar stat-icon"></i>
    </div>
    <div class="stat-card danger">
      <div class="stat-label">Outstanding</div>
      <div class="stat-value"><%- fmtShort(totalOutstanding) %></div>
      <div class="stat-sub"><%- debtors.length %> customers</div>
      <i class="fas fa-clock stat-icon"></i>
    </div>
    <div class="stat-card warn">
      <div class="stat-label">Payables</div>
      <div class="stat-value"><%- fmtShort(supplierDues) %></div>
      <div class="stat-sub"><%- creditors.length %> suppliers</div>
      <i class="fas fa-industry stat-icon"></i>
    </div>
  </div>

  <!-- ══ YTD P&L BAR ═════════════════════════════════════════ -->
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:11px 18px;margin-bottom:22px;display:flex;align-items:center;gap:18px;flex-wrap:wrap">
    <span style="font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.8px;font-weight:600;white-space:nowrap">
      <i class="fas fa-chart-pie" style="color:var(--accent)"></i> YTD P&L
    </span>
    <div style="display:flex;align-items:center;gap:5px;font-size:13px"><span style="color:var(--text2)">Sales</span><strong style="color:var(--accent2)"><%- fmtShort(totalSales) %></strong></div>
    <span style="color:var(--border)">−</span>
    <div style="display:flex;align-items:center;gap:5px;font-size:13px"><span style="color:var(--text2)">Purchases</span><strong style="color:var(--warn)"><%- fmtShort(totalPurchases) %></strong></div>
    <span style="color:var(--border)">−</span>
    <div style="display:flex;align-items:center;gap:5px;font-size:13px"><span style="color:var(--text2)">Expenses</span><strong style="color:var(--danger)"><%- fmtShort(totalExpenses) %></strong></div>
    <span style="color:var(--border)">=</span>
    <div style="margin-left:auto;display:flex;align-items:center;gap:8px">
      <span style="color:var(--text2);font-size:13px">Net Profit</span>
      <strong style="font-size:18px;color:<%- ytdProfit>=0?'var(--accent2)':'var(--danger)' %>"><%- fmtShort(Math.abs(ytdProfit)) %></strong>
      <span style="font-size:11px;padding:2px 8px;border-radius:20px;font-weight:600;
        background:<%- ytdProfit>=0?'rgba(0,212,170,.12)':'rgba(255,77,109,.12)' %>;
        color:<%- ytdProfit>=0?'var(--accent2)':'var(--danger)' %>"><%- ytdProfit>=0?'Profit':'Loss' %></span>
    </div>
  </div>

  <!-- ══ TREND CHART + P&L DONUT ═════════════════════════════ -->
  <div style="display:grid;grid-template-columns:3fr 2fr;gap:20px;margin-bottom:22px">
    <div class="card">
      <div class="card-title"><i class="fas fa-chart-pie" style="color:var(--accent)"></i> Sales vs Collections vs Purchases — <%- selMonthLabel %></div>
      <% if(periodSales===0 && periodCollections===0 && periodPurchases===0){ %>
        <div class="empty" style="height:220px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px"><i class="fas fa-chart-pie" style="font-size:28px;opacity:.25"></i><span>No data for this month</span></div>
      <% } else { %>
        <div style="height:170px"><canvas id="trendChart"></canvas></div>
        <div style="display:flex;justify-content:center;gap:14px;margin-top:8px;flex-wrap:wrap">
          <% [['Sales','#5b8dee',periodSales],['Collections','#00d4aa',periodCollections],['Purchases','#ffb84d',periodPurchases]].forEach(function(it){ %>
          <div style="display:flex;align-items:center;gap:5px;font-size:11px">
            <span style="width:8px;height:8px;border-radius:2px;background:<%- it[1] %>;display:inline-block"></span>
            <span style="color:var(--text2)"><%- it[0] %></span>
            <strong style="color:var(--text)"><%- fmtShort(it[2]) %></strong>
          </div>
          <% }) %>
        </div>
      <% } %>
    </div>
    <div class="card">
      <div class="card-title"><i class="fas fa-chart-pie" style="color:var(--accent2)"></i> YTD P&L Split</div>
      <% if(totalSales===0){ %>
        <div class="empty" style="height:220px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px"><i class="fas fa-chart-pie" style="font-size:28px;opacity:.25"></i><span>No data</span></div>
      <% } else { %>
        <div style="height:180px"><canvas id="plDonut"></canvas></div>
        <div style="display:flex;justify-content:center;gap:16px;margin-top:8px;flex-wrap:wrap">
          <% var plItems=[
            {label:'Purchases',color:'#ffb84d',val:totalPurchases},
            {label:'Expenses',color:'#ff4d6d',val:totalExpenses},
            {label:'Net Profit',color:'#00d4aa',val:Math.max(0,ytdProfit)}
          ]; %>
          <% plItems.forEach(function(it){ %>
          <div style="display:flex;align-items:center;gap:5px;font-size:11px">
            <span style="width:8px;height:8px;border-radius:2px;background:<%- it.color %>;display:inline-block"></span>
            <span style="color:var(--text2)"><%- it.label %></span>
            <strong style="color:var(--text)"><%- fmtShort(it.val) %></strong>
          </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- ══ RECEIVABLES AGING ════════════════════════════════════ -->
  <% if(debtors.length>0){ %>
  <div style="margin-bottom:22px">
    <div style="font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.8px;font-weight:600;margin-bottom:10px">
      <i class="fas fa-hourglass-half" style="color:var(--warn);margin-right:5px"></i>Receivables Aging
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px">
      <%
        var agingDef = [
          {key:'a0',  label:'0 – 30 days', color:'var(--accent2)', bg:'rgba(0,212,170,.1)'},
          {key:'a30', label:'31 – 60 days',color:'#5b8dee',        bg:'rgba(91,141,238,.1)'},
          {key:'a60', label:'61 – 90 days',color:'var(--warn)',    bg:'rgba(255,184,77,.1)'},
          {key:'a90', label:'90+ days',    color:'var(--danger)',  bg:'rgba(255,77,109,.1)'}
        ];
      %>
      <% agingDef.forEach(function(ag){ var b=aging[ag.key]; %>
      <div style="background:<%- ag.bg %>;border:1px solid <%- ag.color %>33;border-radius:var(--radius);padding:14px 16px">
        <div style="font-size:11px;color:<%- ag.color %>;font-weight:600;text-transform:uppercase;letter-spacing:.6px;margin-bottom:6px"><%- ag.label %></div>
        <div style="font-size:20px;font-weight:700;color:var(--text);margin-bottom:2px"><%- fmt(b.amt) %></div>
        <div style="font-size:12px;color:var(--text2)"><%- b.count %> customer<%- b.count!==1?'s':'' %></div>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- ══ CUSTOMER OUTSTANDING + SUPPLIER PAYABLES ══════════════ -->
  <div style="display:grid;grid-template-columns:3fr 2fr;gap:20px;margin-bottom:22px">

    <!-- Customer outstanding -->
    <div class="card" style="padding:0;overflow:hidden">
      <div style="padding:13px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px">
        <i class="fas fa-users" style="color:var(--accent2);font-size:12px"></i>
        <span style="font-size:12px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px">Customer Outstanding</span>
        <span style="margin-left:auto;font-size:13px;color:var(--danger);font-weight:700"><%- fmt(totalOutstanding) %></span>
      </div>
      <% if(debtors.length===0){ %>
        <div class="empty" style="padding:28px"><i class="fas fa-check-circle" style="color:var(--accent2)"></i><br>No outstanding receivables</div>
      <% } else { %>
      <div class="table-wrap" style="max-height:340px;overflow-y:auto">
        <table>
          <thead><tr>
            <th style="width:28px">#</th><th>Customer</th>
            <th style="text-align:right">Balance</th>
            <th style="text-align:center">Last Payment</th>
            <th style="text-align:center">Days</th>
          </tr></thead>
          <tbody>
          <% debtors.forEach(function(d,i){
               var ds = daysSince(d.lastPaymentDate);
               var dc = ds===null?'var(--text2)':ds>90?'var(--danger)':ds>45?'var(--warn)':'var(--accent2)';
          %>
            <tr>
              <td class="muted" style="font-size:11px"><%- i+1 %></td>
              <td style="font-weight:500;font-size:13px"><%- d.name %></td>
              <td style="text-align:right;color:var(--danger);font-weight:700"><%- fmt(d.balance) %></td>
              <td style="text-align:center;font-size:12px;color:var(--text2)">
                <%- d.lastPaymentDate ? new Date(d.lastPaymentDate).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '—' %>
              </td>
              <td style="text-align:center">
                <% if(ds!==null){ %><span style="font-size:11px;padding:2px 7px;border-radius:20px;font-weight:600;background:<%- ds>90?'rgba(255,77,109,.12)':ds>45?'rgba(255,169,77,.12)':'rgba(0,212,170,.1)' %>;color:<%- dc %>"><%- ds %>d</span>
                <% } else { %><span class="muted">—</span><% } %>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <div style="padding:8px 16px;border-top:1px solid var(--border);display:flex;justify-content:space-between;font-size:12px;color:var(--text2)">
        <span><%- debtors.length %> customers</span>
        <strong style="color:var(--text)">Total: <%- fmt(totalOutstanding) %></strong>
      </div>
      <% } %>
    </div>

    <!-- Supplier payables -->
    <div class="card" style="padding:0;overflow:hidden">
      <div style="padding:13px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px">
        <i class="fas fa-industry" style="color:var(--warn);font-size:12px"></i>
        <span style="font-size:12px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px">Supplier Payables</span>
        <span style="margin-left:auto;font-size:13px;color:var(--warn);font-weight:700"><%- fmt(supplierDues) %></span>
      </div>
      <% if(creditors.length===0){ %>
        <div class="empty" style="padding:28px"><i class="fas fa-circle-check" style="color:var(--accent2)"></i><br>No outstanding payables</div>
      <% } else { %>
      <div class="table-wrap" style="max-height:340px;overflow-y:auto">
        <table>
          <thead><tr>
            <th style="width:28px">#</th><th>Supplier</th>
            <th style="text-align:right">Owed</th>
            <th style="text-align:center">Last Purchase</th>
            <th style="text-align:center">Days</th>
          </tr></thead>
          <tbody>
          <% creditors.forEach(function(cr,i){
               var ds = daysSince(cr.lastPurchaseDate);
               var dc = ds===null?'var(--text2)':ds>60?'var(--danger)':ds>30?'var(--warn)':'var(--accent2)';
          %>
            <tr>
              <td class="muted" style="font-size:11px"><%- i+1 %></td>
              <td style="font-weight:500;font-size:13px"><%- cr.name %></td>
              <td style="text-align:right;color:var(--warn);font-weight:700"><%- fmt(cr.balance) %></td>
              <td style="text-align:center;font-size:12px;color:var(--text2)">
                <%- cr.lastPurchaseDate ? new Date(cr.lastPurchaseDate).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '—' %>
              </td>
              <td style="text-align:center">
                <% if(ds!==null){ %><span style="font-size:11px;padding:2px 7px;border-radius:20px;font-weight:600;background:<%- ds>60?'rgba(255,77,109,.12)':ds>30?'rgba(255,169,77,.12)':'rgba(0,212,170,.1)' %>;color:<%- dc %>"><%- ds %>d</span>
                <% } else { %><span class="muted">—</span><% } %>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <div style="padding:8px 16px;border-top:1px solid var(--border);display:flex;justify-content:space-between;font-size:12px;color:var(--text2)">
        <span><%- creditors.length %> suppliers</span>
        <strong style="color:var(--text)">Total: <%- fmt(supplierDues) %></strong>
      </div>
      <% } %>
    </div>
  </div>

  <!-- ══ TOP CUSTOMERS + TOP SUPPLIERS BY PERIOD ══════════════ -->
  <% if(topCustSales.length>0 || topSuppPurchase.length>0){ %>
  <div class="grid-2" style="margin-bottom:22px">
    <div class="card">
      <div class="card-title"><i class="fas fa-crown" style="color:#ffd700"></i> Top Customers by Sales — <%- selMonthLabel %></div>
      <% if(topCustSales.length===0){ %>
        <div class="empty" style="height:160px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px"><i class="fas fa-users" style="font-size:22px;opacity:.25"></i><span>No sales data</span></div>
      <% } else { %>
        <div style="height:220px"><canvas id="custChart"></canvas></div>
      <% } %>
    </div>
    <div class="card">
      <div class="card-title"><i class="fas fa-truck" style="color:var(--warn)"></i> Top Suppliers by Purchases — <%- selMonthLabel %></div>
      <% if(topSuppPurchase.length===0){ %>
        <div class="empty" style="height:160px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px"><i class="fas fa-industry" style="font-size:22px;opacity:.25"></i><span>No purchase data</span></div>
      <% } else { %>
        <div style="height:220px"><canvas id="suppChart"></canvas></div>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- ══ EXPENSE ANALYSIS ═════════════════════════════════════ -->
  <% if(expenseBreakdown.length>0){ %>
  <div class="grid-2" style="margin-bottom:22px">
    <div class="card">
      <div class="card-title"><i class="fas fa-receipt" style="color:var(--danger)"></i> Expense Breakdown (YTD)</div>
      <div style="height:220px"><canvas id="expPie"></canvas></div>
    </div>
    <div class="card">
      <div class="card-title"><i class="fas fa-list" style="color:var(--danger)"></i> Expense Ledgers</div>
      <% var maxExp = expenseBreakdown[0].balance; %>
      <div style="display:flex;flex-direction:column;gap:7px;max-height:260px;overflow-y:auto">
        <% expenseBreakdown.forEach(function(e){ %>
        <div style="display:flex;align-items:center;gap:10px">
          <span style="font-size:12px;color:var(--text);min-width:130px;max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<%- e.name %>"><%- e.name %></span>
          <div style="flex:1;height:7px;background:var(--bg3);border-radius:4px;overflow:hidden">
            <div style="height:100%;width:<%- Math.max(2,Math.round(e.balance/maxExp*100)) %>%;background:linear-gradient(90deg,#ff4d6d,#ff8fa3);border-radius:4px"></div>
          </div>
          <span style="font-size:12px;color:var(--danger);font-weight:600;min-width:65px;text-align:right"><%- fmtShort(e.balance) %></span>
        </div>
        <% }) %>
      </div>
      <div style="margin-top:10px;padding-top:8px;border-top:1px solid var(--border);font-size:12px;color:var(--text2)">
        Total Expenses (YTD): <strong style="color:var(--danger)"><%- fmt(totalExpenses) %></strong>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ══ TALLY STOCK SUMMARY ══════════════════════════════════ -->
  <% if(stockItems && stockItems.length>0){ %>
  <div class="card" style="padding:0;overflow:hidden;margin-bottom:22px">
    <div style="padding:13px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px">
      <i class="fas fa-boxes-stacked" style="color:var(--accent);font-size:12px"></i>
      <span style="font-size:12px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px">Tally Stock Inventory</span>
      <span style="margin-left:auto;font-size:13px;color:var(--accent2);font-weight:700">
        <%- stockItems.length %> items · Value: <%- fmtShort(totalStockValue) %>
      </span>
    </div>
    <div class="table-wrap" style="max-height:320px;overflow-y:auto">
      <table>
        <thead><tr>
          <th style="width:28px">#</th>
          <th>Item Name</th>
          <th>Category</th>
          <th style="text-align:right">Qty</th>
          <th style="text-align:right">Value</th>
          <th style="text-align:right">% of Stock</th>
        </tr></thead>
        <tbody>
        <% stockItems.forEach(function(s,i){ %>
          <tr>
            <td class="muted" style="font-size:11px"><%- i+1 %></td>
            <td style="font-weight:500;font-size:13px"><%- s.name %></td>
            <td class="muted" style="font-size:12px"><%- s.parent||'—' %></td>
            <td style="text-align:right;font-size:13px;font-weight:600"><%- Math.round(s.qty).toLocaleString('en-IN') %></td>
            <td style="text-align:right;color:var(--accent2);font-weight:700"><%- fmt(s.value) %></td>
            <td style="text-align:right">
              <% var pct = totalStockValue>0 ? Math.round(s.value/totalStockValue*100) : 0; %>
              <div style="display:flex;align-items:center;gap:6px;justify-content:flex-end">
                <div style="width:50px;height:5px;background:var(--bg3);border-radius:3px;overflow:hidden">
                  <div style="height:100%;width:<%- pct %>%;background:var(--accent);border-radius:3px"></div>
                </div>
                <span style="font-size:11px;color:var(--text2);min-width:28px;text-align:right"><%- pct %>%</span>
              </div>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <div style="padding:8px 16px;border-top:1px solid var(--border);font-size:12px;color:var(--text2);display:flex;justify-content:space-between">
      <span><%- stockItems.length %> stock items</span>
      <strong style="color:var(--text)">Total Stock Value: <%- fmt(totalStockValue) %></strong>
    </div>
  </div>
  <% } %>

  <!-- ══ PERIOD VOUCHERS ══════════════════════════════════════ -->
  <%
    var isCollection = function(v){ return (v.type === 'Journal' || /receipt/i.test(v.type)) && !/stock journal/i.test(v.type); };
    var vSales    = periodVouchers.filter(function(v){ return /sales/i.test(v.type); });
    var vPurchase = periodVouchers.filter(function(v){ return /purchase/i.test(v.type); });
    var vReceipt  = periodVouchers.filter(isCollection);
    var vPayment  = periodVouchers.filter(function(v){ return /payment/i.test(v.type); });
    var sumOf     = function(arr){ return arr.reduce(function(s,v){ return s+(v.amount||0); },0); };
    var badgeCls  = function(t){ t=(t||'').toLowerCase(); return t.includes('sales')?'badge-accepted':t.includes('purchase')?'badge-partial':(t==='journal'||t.includes('receipt'))?'badge-paid':t.includes('payment')?'badge-warn':'badge-default'; };
    var typeKey   = function(t){ t=(t||'').toLowerCase(); return t.includes('sales')?'sales':t.includes('purchase')?'purchase':(t==='journal'||t.includes('receipt'))?'receipt':t.includes('payment')?'payment':'other'; };
    var typeClr   = function(t){ t=(t||'').toLowerCase(); if(t.includes('sales')) return {b:'#00d4aa',a:'var(--accent2)'}; if(t.includes('purchase')) return {b:'#ffb84d',a:'var(--warn)'}; if(t==='journal'||t.includes('receipt')) return {b:'#5b8dee',a:'#5b8dee'}; if(t.includes('payment')) return {b:'#ff6b81',a:'#ff6b81'}; return {b:'var(--border)',a:'var(--text)'}; };
  %>
  <div class="card" id="voucherSection" style="padding:0;overflow:hidden;margin-bottom:24px">

    <!-- Card header -->
    <div style="padding:13px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px">
      <i class="fas fa-scroll" style="color:var(--accent);font-size:13px"></i>
      <span style="font-size:12px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px">Transaction Ledger — <%- selMonthLabel %></span>
      <% if(periodVouchers.length>0){ %>
      <span style="margin-left:auto;background:var(--bg3);border:1px solid var(--border);border-radius:20px;padding:2px 10px;font-size:12px;color:var(--text2)"><%- periodVouchers.length %> entries</span>
      <% } %>
    </div>

    <% if(periodVouchers.length===0){ %>
      <div class="empty" style="padding:40px">
        <i class="fas fa-scroll" style="font-size:30px;opacity:.2"></i><br>
        No transactions for <%- selMonthLabel %>
        <% if(!hasDbData){ %>
          <br><span style="font-size:12px;color:var(--text2)">Run <code style="background:var(--bg3);padding:1px 5px;border-radius:3px">node sync-tally-full.js</code> to load history</span>
        <% } else { %>
          <br><span style="font-size:12px;color:var(--text2)">This month has no vouchers in Tally. Select a month with data using the dropdown above.</span>
        <% } %>
      </div>
    <% } else { %>

    <!-- Filter tabs + search bar -->
    <div style="padding:10px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:var(--bg2)">
      <%
        var tabs = [
          {id:'all',      label:'All',       icon:'fa-list',               clr:'#5b8dee', bg:'rgba(91,141,238,.15)',  n:periodVouchers.length, tot:sumOf(periodVouchers)},
          {id:'sales',    label:'Sales',     icon:'fa-arrow-trend-up',     clr:'#00d4aa', bg:'rgba(0,212,170,.15)',   n:vSales.length,    tot:sumOf(vSales)},
          {id:'purchase', label:'Purchases', icon:'fa-cart-flatbed',       clr:'#ffb84d', bg:'rgba(255,184,77,.15)',  n:vPurchase.length, tot:sumOf(vPurchase)},
          {id:'receipt',  label:'Collections', icon:'fa-hand-holding-dollar',clr:'#5b8dee', bg:'rgba(91,141,238,.15)', n:vReceipt.length,  tot:sumOf(vReceipt)},
          {id:'payment',  label:'Payments',  icon:'fa-money-bill-transfer', clr:'#ff6b81', bg:'rgba(255,107,129,.15)',n:vPayment.length,  tot:sumOf(vPayment)},
        ];
      %>
      <% tabs.forEach(function(t){ if(t.id!=='all'&&t.n===0) return; %>
      <button onclick="filterV('<%- t.id %>')" id="vt-<%- t.id %>"
        data-bg="<%- t.bg %>" data-clr="<%- t.clr %>"
        style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;border:1.5px solid <%- t.clr %>33;background:<%- t.id==='all'?t.bg:'transparent' %>;color:<%- t.clr %>;cursor:pointer;font-size:12px;font-weight:600;transition:all .15s" class="vt">
        <i class="fas <%- t.icon %>" style="font-size:10px"></i>
        <%- t.label %>
        <span style="background:<%- t.bg %>;padding:1px 7px;border-radius:12px;font-size:11px"><%- t.n %></span>
        <% if(t.tot>0){ %><span style="font-size:11px;opacity:.7"><%- fmtShort(t.tot) %></span><% } %>
      </button>
      <% }) %>
      <div style="margin-left:auto;position:relative">
        <i class="fas fa-magnifying-glass" style="position:absolute;left:9px;top:50%;transform:translateY(-50%);color:var(--text2);font-size:11px;pointer-events:none"></i>
        <input id="vSearch" oninput="searchV(this.value)" placeholder="Search party, #…"
          style="background:var(--bg3);border:1px solid var(--border);border-radius:7px;padding:6px 10px 6px 28px;font-size:12px;color:var(--text);width:180px;outline:none">
      </div>
    </div>

    <!-- Table -->
    <div style="overflow-x:auto;max-height:500px;overflow-y:auto">
      <table id="vTable" style="width:100%;border-collapse:collapse">
        <thead>
          <tr style="background:var(--bg2);position:sticky;top:0;z-index:1">
            <th style="padding:10px 16px;text-align:left;font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px;border-bottom:1px solid var(--border);white-space:nowrap">Date</th>
            <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px;border-bottom:1px solid var(--border)">Type</th>
            <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px;border-bottom:1px solid var(--border)">Voucher #</th>
            <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px;border-bottom:1px solid var(--border)">Party</th>
            <th style="padding:10px 16px;text-align:right;font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px;border-bottom:1px solid var(--border)">Amount</th>
          </tr>
        </thead>
        <tbody>
        <% periodVouchers.forEach(function(v,i){
             var tc  = typeClr(v.type);
             var key = typeKey(v.type);
             var dt  = v.dateStr ? new Date(v.dateStr) : null;
             var day = dt ? dt.toLocaleDateString('en-IN',{day:'2-digit',month:'short'}) : '—';
             var yr  = dt ? dt.getFullYear().toString().slice(2) : '';
        %>
          <tr id="vrow-<%- i %>"
            data-type="<%- key %>"
            data-search="<%- ((v.party||'')+(v.voucherNumber||'')+(v.narration||'')).toLowerCase() %>"
            style="border-bottom:1px solid var(--border);border-left:3px solid <%- tc.b %>;transition:background .1s"
            onmouseover="this.style.background='var(--bg2)'" onmouseout="this.style.background=''">
            <td style="padding:10px 16px;white-space:nowrap">
              <span style="font-size:13px;font-weight:600;color:var(--text)"><%- day %></span>
              <span style="font-size:11px;color:var(--text2);margin-left:3px">'<%- yr %></span>
            </td>
            <td style="padding:10px 14px"><span class="badge <%- badgeCls(v.type) %>" style="font-size:11px"><%- v.type %></span></td>
            <td style="padding:10px 14px;font-size:12px;color:var(--text2);font-family:monospace;white-space:nowrap"><%- v.voucherNumber||'—' %></td>
            <td style="padding:10px 14px">
              <div style="font-weight:500;font-size:13px;max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text)" title="<%- v.party %>"><%- v.party||'—' %></div>
              <% if(v.narration){ %><div style="font-size:11px;color:var(--text2);max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:1px" title="<%- v.narration %>"><%- v.narration %></div><% } %>
            </td>
            <td style="padding:10px 16px;text-align:right;font-weight:700;font-size:14px;color:<%- tc.a %>;white-space:nowrap"><%- fmt(v.amount) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Footer totals -->
    <div style="padding:10px 18px;border-top:2px solid var(--border);background:var(--bg2);display:flex;align-items:center;gap:6px;flex-wrap:wrap">
      <span id="vCount" style="font-size:12px;color:var(--text2);margin-right:8px"><%- periodVouchers.length %> entries</span>
      <% if(vSales.length){    %><div style="display:flex;align-items:center;gap:5px;padding:4px 10px;background:rgba(0,212,170,.08);border:1px solid rgba(0,212,170,.2);border-radius:6px;font-size:12px"><i class="fas fa-arrow-trend-up" style="color:var(--accent2);font-size:10px"></i><span style="color:var(--text2)">Sales</span><strong style="color:var(--accent2)"><%- fmt(sumOf(vSales)) %></strong></div><% } %>
      <% if(vPurchase.length){ %><div style="display:flex;align-items:center;gap:5px;padding:4px 10px;background:rgba(255,184,77,.08);border:1px solid rgba(255,184,77,.2);border-radius:6px;font-size:12px"><i class="fas fa-cart-flatbed" style="color:var(--warn);font-size:10px"></i><span style="color:var(--text2)">Purchases</span><strong style="color:var(--warn)"><%- fmt(sumOf(vPurchase)) %></strong></div><% } %>
      <% if(vReceipt.length){  %><div style="display:flex;align-items:center;gap:5px;padding:4px 10px;background:rgba(91,141,238,.08);border:1px solid rgba(91,141,238,.2);border-radius:6px;font-size:12px"><i class="fas fa-hand-holding-dollar" style="color:#5b8dee;font-size:10px"></i><span style="color:var(--text2)">Receipts</span><strong style="color:#5b8dee"><%- fmt(sumOf(vReceipt)) %></strong></div><% } %>
      <% if(vPayment.length){  %><div style="display:flex;align-items:center;gap:5px;padding:4px 10px;background:rgba(255,107,129,.08);border:1px solid rgba(255,107,129,.2);border-radius:6px;font-size:12px"><i class="fas fa-money-bill-transfer" style="color:#ff6b81;font-size:10px"></i><span style="color:var(--text2)">Payments</span><strong style="color:#ff6b81"><%- fmt(sumOf(vPayment)) %></strong></div><% } %>
    </div>

    <% } %>
  </div>

  <script>
  var _vTab='all', _vQ='';
  function filterV(id) {
    _vTab = id;
    document.querySelectorAll('.vt').forEach(function(b) {
      var active = b.id === 'vt-'+id;
      b.style.background = active ? b.dataset.bg : 'transparent';
      b.style.borderColor= active ? b.dataset.clr : b.dataset.clr+'33';
    });
    applyV();
  }
  function searchV(q) { _vQ = q.toLowerCase(); applyV(); }
  function applyV() {
    var rows = document.querySelectorAll('#vTable tbody tr');
    var n = 0;
    rows.forEach(function(r) {
      var ok = (_vTab==='all' || r.dataset.type===_vTab) && (!_vQ || r.dataset.search.includes(_vQ));
      r.style.display = ok ? '' : 'none';
      if(ok) n++;
    });
    var el = document.getElementById('vCount');
    if(el) el.textContent = n + (n===1?' entry':' entries');
  }
  </script>

  </div><!-- /page -->
</div><!-- /main -->
<%- include('partials/foot') %>

<!-- ── Sync button JS ─────────────────────────────────────── -->
<script>
async function syncNow() {
  const btn=document.getElementById('syncBtn'), icon=document.getElementById('syncIcon'), txt=document.getElementById('syncText');
  btn.disabled=true; icon.className='fas fa-spinner fa-spin'; txt.textContent='Syncing…';
  try {
    const d = await (await fetch('/api/tally/sync',{method:'POST'})).json();
    if (d.ok) {
      icon.className='fas fa-check'; txt.textContent='Saved · '+(d.label||'Done');
      setTimeout(()=>location.reload(),1200);
    } else {
      icon.className='fas fa-xmark'; txt.textContent='Failed'; btn.disabled=false;
      alert('Sync failed: '+(d.error||'Unknown')); setTimeout(()=>{icon.className='fas fa-cloud-arrow-up';txt.textContent='Sync to DB';},2000);
    }
  } catch(e) {
    icon.className='fas fa-xmark'; txt.textContent='Error'; btn.disabled=false;
    alert('Error: '+e.message); setTimeout(()=>{icon.className='fas fa-cloud-arrow-up';txt.textContent='Sync to DB';},2000);
  }
}
</script>

