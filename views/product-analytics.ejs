<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main">
  <%- include('partials/header', {pageTitle: 'Product Analytics'}) %>
  <div class="page">

    <!-- PRODUCT HEADER -->
    <div class="card" style="margin-bottom:20px;padding:18px 20px">
      <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
        <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,var(--accent2),var(--accent));
                    display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <i class="fas fa-box" style="color:#fff;font-size:20px"></i>
        </div>
        <div style="flex:1;min-width:0">
          <div style="font-size:20px;font-weight:700"><%- productName %></div>
          <div style="font-size:13px;color:var(--text2);margin-top:3px">
            <%- variants.length %> variant<%- variants.length!==1?'s':'' %> ·
            <% if(outCount>0){ %><span style="color:var(--danger)"><%- outCount %> out of stock</span><% } %>
            <% if(outCount>0&&lowCount>0){ %> · <% } %>
            <% if(lowCount>0){ %><span style="color:var(--warn)"><%- lowCount %> low stock</span><% } %>
            <% if(outCount===0&&lowCount===0&&variants.length>0){ %><span style="color:var(--accent2)">All in stock</span><% } %>
          </div>
        </div>
        <a href="/" style="color:var(--text2);font-size:13px;text-decoration:none;flex-shrink:0">
          <i class="fas fa-arrow-left"></i> Dashboard
        </a>
      </div>
    </div>

    <!-- STAT CARDS -->
    <div class="stats-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:20px">
      <div class="stat-card success">
        <div class="stat-label">Sales Value (6mo)</div>
        <div class="stat-value" id="pStatVal"><%- fmtShort(totalVal) %></div>
        <div class="stat-sub" id="pStatValSub">Last 6 months</div>
        <i class="fas fa-indian-rupee-sign stat-icon"></i>
      </div>
      <div class="stat-card">
        <div class="stat-label">Qty Sold (6mo)</div>
        <div class="stat-value" id="pStatQty"><%- totalQty %></div>
        <div class="stat-sub" id="pStatQtySub">Units in 6 months</div>
        <i class="fas fa-boxes-stacked stat-icon"></i>
      </div>
      <div class="stat-card <%- outCount>0?'danger':lowCount>0?'warn':'' %>">
        <div class="stat-label">Current Stock</div>
        <div class="stat-value"><%- currentStock %></div>
        <div class="stat-sub">
          <%- outCount>0 ? outCount+' variant(s) out' : lowCount>0 ? lowCount+' variant(s) low' : 'All variants stocked' %>
        </div>
        <i class="fas fa-warehouse stat-icon"></i>
      </div>
      <div class="stat-card">
        <div class="stat-label">Avg Daily Sales</div>
        <div class="stat-value"><%- avgDaily %></div>
        <div class="stat-sub">Units/day (6mo avg)</div>
        <i class="fas fa-chart-line stat-icon"></i>
      </div>
    </div>

    <!-- FILTERS -->
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap;background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:12px 16px">
      <i class="fas fa-filter" style="color:var(--text2);font-size:13px"></i>
      <label style="font-size:13px;color:var(--text2)">Month:</label>
      <select id="monthFilter" onchange="applyFilter()"
        style="background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:6px 14px;border-radius:8px;font-size:13px;outline:none;cursor:pointer">
        <option value="">All 6 Months</option>
        <% [...monthlyTrend].reverse().forEach(function(m){ %>
          <option value="<%- m.key %>"><%- m.label %></option>
        <% }) %>
      </select>
      <label style="font-size:13px;color:var(--text2);margin-left:8px">Variant:</label>
      <select id="variantFilter" onchange="applyFilter()"
        style="background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:6px 14px;border-radius:8px;font-size:13px;outline:none;cursor:pointer">
        <option value="">All Variants</option>
        <% variants.forEach(function(v){ %>
          <option value="<%- v.name %>"><%- v.name %></option>
        <% }) %>
      </select>
      <button onclick="clearFilter()" style="background:none;border:1px solid var(--border);color:var(--text2);padding:6px 14px;border-radius:8px;font-size:12px;cursor:pointer">
        <i class="fas fa-xmark"></i> Clear
      </button>
    </div>

    <!-- TREND CHART + VARIANT BREAKDOWN -->
    <div class="grid-2" style="margin-bottom:20px">
      <div class="card">
        <div class="card-title"><i class="fas fa-chart-column"></i> Monthly Sales Trend <span id="trendLabel" style="font-size:11px;color:var(--text2);font-weight:400;margin-left:6px"></span></div>
        <div class="chart-box"><canvas id="trendChart"></canvas></div>
      </div>
      <div class="card">
        <div class="card-title"><i class="fas fa-layer-group"></i> Variant / Flavour Breakdown</div>
        <% if(variants.length===0){ %>
          <div class="empty"><i class="fas fa-box-open"></i>No variant data found</div>
        <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Variant / Flavour</th>
                <th>Code</th>
                <th style="text-align:right">Stock</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="variantBody">
            <% variants.forEach(function(v){ %>
              <tr id="vrow-<%- encodeURIComponent(v.name) %>"
                  style="cursor:pointer;transition:background .15s"
                  data-vname="<%- v.name %>"
                  onclick="selectVariant(this.dataset.vname)"
                  onmouseover="this.style.background='rgba(108,99,255,.06)'"
                  onmouseout="this.style.background=''">
                <td><strong><%- v.name %></strong></td>
                <td class="muted"><%- v.code %></td>
                <td style="text-align:right;font-weight:700;color:<%- v.quantity<=0?'var(--danger)':v.quantity<=5?'var(--warn)':'var(--accent2)' %>">
                  <%- v.quantity<=0 ? '0' : v.quantity %>
                </td>
                <td>
                  <% if(v.status==='Out of Stock'){ %>
                    <span class="badge badge-default" style="background:rgba(255,77,109,.15);color:var(--danger);border:1px solid rgba(255,77,109,.3)">Out of Stock</span>
                  <% } else if(v.status==='Low Stock'){ %>
                    <span class="badge badge-default" style="background:rgba(255,169,77,.15);color:var(--warn);border:1px solid rgba(255,169,77,.3)">Low Stock</span>
                  <% } else { %>
                    <span class="badge badge-paid">In Stock</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>

    <!-- MONTHLY BREAKDOWN TABLE -->
    <div class="card">
      <div class="card-title"><i class="fas fa-table"></i> Month-wise Sales <span id="monthTableLabel" style="font-size:11px;color:var(--text2);font-weight:400;margin-left:6px"></span></div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Month</th>
              <th style="text-align:right">Qty Sold</th>
              <th style="text-align:right">Revenue</th>
              <th style="text-align:right">Avg/Unit</th>
            </tr>
          </thead>
          <tbody id="monthBody"></tbody>
          <tfoot>
            <tr style="border-top:2px solid var(--border)">
              <td><strong>Total</strong></td>
              <td style="text-align:right;font-weight:700" id="footQty"></td>
              <td style="text-align:right;font-weight:700;color:var(--accent2)" id="footVal"></td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

  </div>
</div>
<%- include('partials/foot') %>

<script>
const TREND    = <%- trendJSON %>;
const VARIANTS = <%- variantsJSON %>;
const COLORS   = { accent:'#6c63ff', accent2:'#00d4aa', warn:'#ffa94d', danger:'#ff4d6d', text2:'#8891b5' };

function fmtShort(n) {
  if(n==null||isNaN(n)) return '—';
  const a=Math.abs(n);
  if(a>=1e7) return '₹'+(n/1e7).toFixed(2)+' Cr';
  if(a>=1e5) return '₹'+(n/1e5).toFixed(1)+' L';
  if(a>=1e3) return '₹'+Math.round(n/1e3)+'K';
  return '₹'+Math.round(n);
}
function fmtFull(n){ return '₹'+Math.round(n||0).toLocaleString('en-IN'); }

Chart.defaults.color = COLORS.text2;
Chart.defaults.borderColor = 'rgba(108,99,255,.1)';

const trendChart = new Chart(document.getElementById('trendChart'), {
  type:'bar',
  data:{
    labels:   TREND.map(m=>m.label),
    datasets:[
      { label:'Revenue', data:TREND.map(m=>Math.round(m.val)),
        backgroundColor:'rgba(0,212,170,.55)', borderColor:COLORS.accent2, borderWidth:1, borderRadius:5, yAxisID:'y' },
      { label:'Qty', data:TREND.map(m=>m.qty),
        type:'line', borderColor:COLORS.accent, backgroundColor:'rgba(108,99,255,.12)',
        borderWidth:2, pointRadius:4, tension:.35, fill:true, yAxisID:'y1' }
    ]
  },
  options:{
    responsive:true, maintainAspectRatio:false,
    plugins:{ legend:{ display:true, labels:{ color:COLORS.text2, boxWidth:12 } } },
    scales:{
      y:  { beginAtZero:true, ticks:{ callback:v=>fmtShort(v) }, grid:{ color:'rgba(108,99,255,.07)' } },
      y1: { position:'right', beginAtZero:true, ticks:{ precision:0 }, grid:{ display:false } },
      x:  { grid:{ display:false } }
    }
  }
});

let activeVariant = '';

function selectVariant(name) {
  activeVariant = activeVariant === name ? '' : name;
  document.getElementById('variantFilter').value = activeVariant;
  applyFilter();
}

function applyFilter() {
  const month   = document.getElementById('monthFilter').value;
  const variant = document.getElementById('variantFilter').value || activeVariant;
  activeVariant = variant;

  // Filter monthly trend
  const trendFiltered = month ? TREND.filter(m => m.key === month) : TREND;

  // Update chart
  trendChart.data.labels   = trendFiltered.map(m=>m.label);
  trendChart.data.datasets[0].data = trendFiltered.map(m=>Math.round(m.val));
  trendChart.data.datasets[1].data = trendFiltered.map(m=>m.qty);
  trendChart.update();
  document.getElementById('trendLabel').textContent = month ? '— ' + (trendFiltered[0]?.label||'') : '';

  // Update stats
  const totQty = trendFiltered.reduce((a,m)=>a+m.qty,0);
  const totVal = trendFiltered.reduce((a,m)=>a+m.val,0);
  document.getElementById('pStatQty').textContent     = totQty;
  document.getElementById('pStatVal').textContent     = fmtShort(totVal);
  document.getElementById('pStatQtySub').textContent  = month || 'Last 6 months';
  document.getElementById('pStatValSub').textContent  = month || 'Last 6 months';
  document.getElementById('monthTableLabel').textContent = month ? '— filtered' : '';

  // Highlight selected variant row
  VARIANTS.forEach(v => {
    const row = document.getElementById('vrow-' + encodeURIComponent(v.name));
    if(row) row.style.background = (variant && v.name===variant) ? 'rgba(108,99,255,.12)' : '';
  });

  // Rebuild month table
  const tbody = document.getElementById('monthBody');
  tbody.innerHTML = trendFiltered.map(m => {
    const avg = m.qty>0 ? m.val/m.qty : 0;
    return `<tr>
      <td>${m.label}</td>
      <td style="text-align:right;font-weight:600">${m.qty}</td>
      <td style="text-align:right;color:var(--accent2)">${fmtFull(m.val)}</td>
      <td style="text-align:right" class="muted">${avg>0?fmtFull(avg):'—'}</td>
    </tr>`;
  }).join('');

  document.getElementById('footQty').textContent = totQty;
  document.getElementById('footVal').textContent = fmtFull(totVal);
}

function clearFilter() {
  document.getElementById('monthFilter').value   = '';
  document.getElementById('variantFilter').value = '';
  activeVariant = '';
  applyFilter();
}

applyFilter();
</script>
