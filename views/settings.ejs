<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main">
  <%- include('partials/header', {pageTitle: 'Settings'}) %>
  <div class="page">

    <div class="card">
      <div class="card-title"><i class="fas fa-gear"></i> Configuration</div>
      <div class="setting-row">
        <div class="setting-label">
          <strong>Moysklad API Token</strong>
          <span>Bearer token used for all Moysklad API calls</span>
        </div>
        <div class="setting-value"><%- token %></div>
      </div>
      <div class="setting-row">
        <div class="setting-label">
          <strong>API Base URL</strong>
          <span>Moysklad REST API endpoint</span>
        </div>
        <div class="setting-value">https://api.moysklad.ru/api/remap/1.2</div>
      </div>
      <div class="setting-row">
        <div class="setting-label">
          <strong>TallyPrime URL</strong>
          <span>Local Tally XML API endpoint</span>
        </div>
        <div class="setting-value">http://localhost:9000</div>
      </div>
      <div class="setting-row">
        <div class="setting-label">
          <strong>Server Port</strong>
          <span>WareSmart dashboard port</span>
        </div>
        <div class="setting-value">3000</div>
      </div>
      <div class="setting-row">
        <div class="setting-label">
          <strong>Signed in as</strong>
          <span>Current Moysklad account</span>
        </div>
        <div class="setting-value"><%- empName %> · <%- empRole %></div>
      </div>
    </div>

    <div class="card" style="margin-top:20px">
      <div class="card-title"><i class="fas fa-circle-info"></i> Quick Links</div>
      <div style="display:flex;gap:12px;flex-wrap:wrap;padding:8px 0">
        <a href="/" style="color:var(--accent);text-decoration:none"><i class="fas fa-chart-pie"></i> Dashboard</a>
        <a href="/tally" style="color:var(--accent);text-decoration:none"><i class="fas fa-building-columns"></i> Financial Dashboard</a>
        <a href="/orders" style="color:var(--accent);text-decoration:none"><i class="fas fa-shopping-cart"></i> Orders</a>
        <a href="/inventory" style="color:var(--accent);text-decoration:none"><i class="fas fa-boxes-stacked"></i> Inventory</a>
        <a href="/reports" style="color:var(--accent);text-decoration:none"><i class="fas fa-chart-bar"></i> Reports</a>
        <a href="/alerts" style="color:var(--accent);text-decoration:none"><i class="fas fa-bell"></i> Alerts</a>
      </div>
    </div>

  </div>
</div>
<%- include('partials/foot') %>
