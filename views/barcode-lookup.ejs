<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main">
  <%- include('partials/header', {pageTitle: 'Barcode Lookup'}) %>
  <div class="page">
    <style>
      .bl-box { display:flex; gap:10px; }
      .bl-box input { flex:1; min-width:0; padding:15px 16px; font-size:19px; font-family:ui-monospace,Consolas,monospace; letter-spacing:1px; background:var(--bg3); border:2px solid var(--border); border-radius:12px; color:var(--text); outline:none; }
      .bl-box input:focus { border-color:var(--accent); box-shadow:0 0 0 4px rgba(217,119,87,.15); }
      .bl-box button { padding:0 22px; border:none; border-radius:12px; background:linear-gradient(135deg,#D97757,#5a52e0); color:#fff; font-weight:600; font-size:14px; cursor:pointer; }
      .bl-kv { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:14px 18px; }
      .bl-kv .k { font-size:10.5px; color:var(--text2); text-transform:uppercase; letter-spacing:.6px; }
      .bl-kv .v { font-size:14px; font-weight:600; margin-top:3px; word-break:break-word; }
      .bl-price { font-size:30px; font-weight:800; color:var(--accent2); line-height:1.1; }
      .bl-table { width:100%; border-collapse:collapse; }
      .bl-table th { text-align:left; font-size:10.5px; color:var(--text2); text-transform:uppercase; letter-spacing:.6px; padding:8px 10px; border-bottom:1px solid var(--border); }
      .bl-table td { padding:9px 10px; border-bottom:1px solid rgba(217,119,87,.06); font-size:13px; }
      .bl-table tr.click { cursor:pointer; }
      .bl-table tr.click:hover { background:rgba(217,119,87,.06); }
      .bl-num { text-align:right; white-space:nowrap; }
      .bl-note { margin-top:10px; padding:10px 12px; border-radius:9px; font-size:12.5px; }
      .bl-mono { font-family:ui-monospace,Consolas,monospace; word-break:break-all; }
      @media (max-width: 760px) { .bl-box input { font-size:16px; padding:13px; } .bl-hide-sm { display:none; } }
    </style>

    <div class="card">
      <div class="card-title"><i class="fas fa-barcode"></i> Look up a barcode</div>
      <form class="bl-box" id="blForm" autocomplete="off">
        <input id="blInput" type="text" placeholder="Scan or type a barcode and press Enter" autofocus spellcheck="false">
        <button type="submit"><i class="fas fa-magnifying-glass"></i> <span class="bl-hide-sm">Look up</span></button>
      </form>
    </div>

    <div id="blResult"></div>

    <div class="card">
      <div class="card-title"><i class="fas fa-clock-rotate-left"></i> Recently scanned barcodes <span style="margin-left:6px;font-size:11px;font-weight:400;text-transform:none;letter-spacing:0;color:var(--text2)">click a row to look it up</span></div>
      <div id="blRecent" style="color:var(--text2);font-size:13px;padding:10px 0"><i class="fas fa-spinner fa-spin"></i> Loading…</div>
    </div>
  </div>

<script>
(function () {
  var IS_ADMIN = <%- isAdmin ? 'true' : 'false' %>;
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function rub(n) { return n == null ? '—' : '₽' + Number(n).toLocaleString('en-US', { maximumFractionDigits: 2 }); }
  function when(iso) { var d = new Date(iso); return isNaN(d) ? '—' : d.toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }); }
  function kv(k, v) { return '<div><div class="k">' + esc(k) + '</div><div class="v">' + v + '</div></div>'; }
  function api(url, opts) {
    return fetch(url, opts).then(function (r) {
      var ct = r.headers.get('content-type') || '';
      if (r.redirected || ct.indexOf('application/json') === -1) throw new Error('Your session has expired. Please reload the page and log in again.');
      return r.json();
    });
  }
  var out = document.getElementById('blResult');

  function show(code) {
    code = String(code || '').trim();
    if (!code) return;
    document.getElementById('blInput').value = code;
    out.innerHTML = '<div class="card" style="color:var(--text2);font-size:13px"><i class="fas fa-spinner fa-spin"></i> Looking up ' + esc(code) + '…</div>';
    api('/api/barcode/lookup?code=' + encodeURIComponent(code)).then(function (d) {
      if (!d.ok) throw new Error(d.error || 'Lookup failed.');
      if (!d.found) {
        out.innerHTML = '<div class="card"><div style="display:flex;gap:12px;align-items:center"><i class="fas fa-circle-question" style="font-size:22px;color:var(--warn)"></i>' +
          '<div><div style="font-weight:700">No record for this barcode</div><div style="font-size:12.5px;color:var(--text2);margin-top:2px"><span class="bl-mono">' + esc(code) + '</span> has not been scanned in the warehouse yet.</div></div></div></div>';
        return;
      }
      render(d);
    }).catch(function (e) {
      out.innerHTML = '<div class="card" style="color:var(--danger);font-size:13px"><i class="fas fa-triangle-exclamation"></i> ' + esc(e.message) + '</div>';
    }).then(function () { var i = document.getElementById('blInput'); i.select(); });
  }

  function render(d) {
    var s = d.scan, o = d.order;
    var priceNote = d.priceChangedSinceScan
      ? '<div class="bl-note" style="background:rgba(240,180,41,.12);color:#c9930b"><i class="fas fa-circle-info"></i> The order\'s price for this product is now ' + rub(d.currentUnitPrice) + ' per unit. The price above is what it was sold at when scanned.</div>'
      : '';
    var missing = !o.existsInMoySklad
      ? '<div class="bl-note" style="background:rgba(229,72,77,.1);color:var(--danger)"><i class="fas fa-triangle-exclamation"></i> This order no longer exists in MoySklad (it was deleted). The barcode record below is kept as it was scanned.</div>'
      : '';
    var customer = o.customerId
      ? '<a href="/customer-analytics?id=' + encodeURIComponent(o.customerId) + '&name=' + encodeURIComponent(o.customerName) + '" style="color:var(--accent);text-decoration:none">' + esc(o.customerName) + ' <i class="fas fa-arrow-up-right-from-square" style="font-size:10px"></i></a>'
      : esc(o.customerName);

    // A barcode saved without a specific product belongs to the order as a
    // whole — show the order's products and selling prices instead.
    var head = s.productName
      ? '<div style="font-size:18px;font-weight:700">' + esc(s.productName) + '</div>'
      : '<div style="font-size:18px;font-weight:700">Carton for order ' + esc(o.name) + '</div><div style="font-size:12.5px;color:var(--text2);margin-top:2px">Product not specified when scanned — see the order\'s products and prices below.</div>';
    var priceBox = s.productName
      ? '<div style="text-align:right"><div style="font-size:10.5px;color:var(--text2);text-transform:uppercase;letter-spacing:.6px">Selling price (per unit)</div>' +
          '<div class="bl-price">' + rub(s.unitPrice) + '</div>' +
          (s.discount ? '<div style="font-size:11.5px;color:var(--text2)">' + rub(s.listPrice) + ' list − ' + s.discount + '% discount</div>' : '') + '</div>'
      : '';
    var html =
      '<div class="card">' +
        '<div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:flex-start">' +
          '<div style="min-width:0"><div class="card-title" style="margin-bottom:6px"><i class="fas fa-barcode"></i> <span class="bl-mono" style="text-transform:none;letter-spacing:0">' + esc(s.barcode) + '</span></div>' +
          head + '</div>' + priceBox +
        '</div>' + priceNote + missing +
        '<div class="bl-kv" style="margin-top:18px">' +
          kv('PO / Sales order', esc(o.name)) +
          kv('Customer', customer) +
          kv('Order date', esc(o.date || '—')) +
          kv('Order status', esc(o.state || '—')) +
          kv('Order total', rub(o.total)) +
          kv('Paid', rub(o.paid)) +
          (s.productName ? kv('Qty of this product ordered', o.orderedQty == null ? '—' : esc(o.orderedQty)) : '') +
          kv('Barcodes scanned on order', esc(o.barcodesScanned)) +
          kv('Planned delivery', esc(o.deliveryPlanned || '—')) +
          kv('Warehouse', esc(o.store || '—')) +
          kv('Salesman', esc(o.salesman || '—')) +
          kv('Scanned', esc(when(s.scannedAt)) + '<div style="font-size:11px;color:var(--text2);font-weight:400">by ' + esc(s.scannedBy) + '</div>') +
        '</div>' +
        (IS_ADMIN ? '<div style="margin-top:16px;text-align:right"><button id="blDelete" style="background:none;border:1px solid var(--border);color:var(--text2);border-radius:8px;padding:6px 12px;cursor:pointer;font-size:12px"><i class="fas fa-trash-can"></i> Delete this barcode record</button></div>' : '') +
      '</div>';

    if (d.orderLines && d.orderLines.length) {
      html += '<div class="card"><div class="card-title"><i class="fas fa-boxes-stacked"></i> Products in this order</div>' +
        '<div style="overflow-x:auto"><table class="bl-table"><thead><tr><th>Product</th><th class="bl-num">Qty</th><th class="bl-num">Selling price</th></tr></thead><tbody>' +
        d.orderLines.map(function (l) {
          var mine = s.productName && l.productName === s.productName;
          return '<tr' + (mine ? ' style="background:rgba(79,174,138,.08)"' : '') + '><td style="font-weight:600">' + esc(l.productName) + (mine ? ' <span style="font-size:10px;color:var(--accent2)">● this barcode</span>' : '') + '</td><td class="bl-num">' + esc(l.quantity) + '</td><td class="bl-num">' + rub(l.unitPrice) + (l.discount ? ' <span style="font-size:11px;color:var(--text2)">(−' + l.discount + '%)</span>' : '') + '</td></tr>';
        }).join('') + '</tbody></table></div></div>';
    }

    html += '<div class="card"><div class="card-title"><i class="fas fa-truck"></i> Shipments for this order</div>' +
      (d.shipments.length
        ? '<div style="overflow-x:auto"><table class="bl-table"><thead><tr><th>Shipment</th><th>Date</th><th class="bl-hide-sm">Warehouse</th><th>Status</th><th class="bl-num">' + (s.productName ? 'This product' : 'Items') + '</th><th class="bl-num">Shipment total</th></tr></thead><tbody>' +
          d.shipments.map(function (x) {
            return '<tr><td style="font-weight:600">' + esc(x.name) + '</td><td>' + esc(x.date) + '</td><td class="bl-hide-sm">' + esc(x.store) + '</td><td>' + esc(x.state) + '</td><td class="bl-num">' + esc(s.productName ? x.productQty : x.totalQty) + ' pcs</td><td class="bl-num">' + rub(x.total) + '</td></tr>';
          }).join('') + '</tbody></table></div>'
        : '<div style="color:var(--text2);font-size:13px">No shipment has been created for this order yet.</div>') +
      '</div>';

    if (d.invoices.length) {
      html += '<div class="card"><div class="card-title"><i class="fas fa-file-invoice"></i> Sales invoices</div><table class="bl-table"><tbody>' +
        d.invoices.map(function (x) { return '<tr><td style="font-weight:600">' + esc(x.name) + '</td><td>' + esc(x.date) + '</td><td class="bl-num">' + rub(x.total) + '</td></tr>'; }).join('') +
        '</tbody></table></div>';
    }
    out.innerHTML = html;

    var del = document.getElementById('blDelete');
    if (del) del.addEventListener('click', function () {
      // Two separate confirmations before a permanent delete.
      if (!confirm('Step 1 of 2\n\nDelete the record for barcode ' + s.barcode + '?\n\nOrder ' + o.name + ' · ' + o.customerName +
                   (s.productName ? '\n' + s.productName : '') + '\n\nAfter deleting, this barcode can be scanned again.')) return;
      if (!confirm('Step 2 of 2 — final confirmation\n\nPermanently delete barcode ' + s.barcode + '?\nThis cannot be undone.')) return;
      api('/api/barcode/' + s.id + '/delete', { method: 'POST' }).then(function (r) {
        if (!r.ok) throw new Error('Could not delete it.');
        out.innerHTML = '<div class="card" style="color:var(--accent2);font-size:13px"><i class="fas fa-check"></i> Barcode record deleted.</div>';
        loadRecent();
      }).catch(function (e) { alert(e.message); });
    });
  }

  function loadRecent() {
    var el = document.getElementById('blRecent');
    api('/api/barcode/recent').then(function (d) {
      if (!d.ok) throw new Error(d.error);
      if (!d.scans.length) { el.textContent = 'No barcodes have been scanned yet.'; return; }
      el.style.padding = '0';
      el.innerHTML = '<div style="overflow-x:auto"><table class="bl-table"><thead><tr><th>Barcode</th><th>Product</th><th>PO</th><th class="bl-hide-sm">Customer</th><th class="bl-num">Price</th><th class="bl-hide-sm">Scanned</th></tr></thead><tbody>' +
        d.scans.map(function (x) {
          return '<tr class="click" data-code="' + esc(x.barcode) + '"><td class="bl-mono" style="font-weight:600">' + esc(x.barcode) + '</td><td>' + (x.productName ? esc(x.productName) : '<span style="color:var(--text2)">Whole order</span>') + '</td><td>' + esc(x.orderName) + '</td><td class="bl-hide-sm">' + esc(x.customerName) + '</td><td class="bl-num">' + rub(x.unitPrice) + '</td><td class="bl-hide-sm" style="font-size:12px;color:var(--text2)">' + esc(when(x.scannedAt)) + ' · ' + esc(x.scannedBy) + '</td></tr>';
        }).join('') + '</tbody></table></div>';
      Array.prototype.forEach.call(el.querySelectorAll('tr.click'), function (tr) {
        tr.addEventListener('click', function () { show(tr.dataset.code); window.scrollTo({ top: 0, behavior: 'smooth' }); });
      });
    }).catch(function (e) { el.textContent = e.message; });
  }

  document.getElementById('blForm').addEventListener('submit', function (e) { e.preventDefault(); show(document.getElementById('blInput').value); });
  var q = new URLSearchParams(location.search).get('code');
  if (q) show(q);
  loadRecent();
})();
</script>

<%- include('partials/foot') %>
