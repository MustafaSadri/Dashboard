<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main">
  <%- include('partials/header', {pageTitle: 'Inventory'}) %>
  <div class="page">

    <!-- Summary Cards -->
    <div class="stats-grid" style="grid-template-columns:repeat(3,1fr)">
      <div class="stat-card success">
        <div class="stat-label">Total SKUs</div>
        <div class="stat-value"><%- totalSKU %></div>
        <div class="stat-sub"><%- models.length %> models</div>
        <i class="fas fa-boxes-stacked stat-icon"></i>
      </div>
      <div class="stat-card warn" style="cursor:pointer" onclick="openInvModal('low')">
        <div class="stat-label">Low Stock</div>
        <div class="stat-value"><%- low %></div>
        <div class="stat-sub">qty ≤ 100</div>
        <div class="inv-view-details">View Details <i class="fas fa-chevron-right" style="font-size:9px"></i></div>
        <i class="fas fa-exclamation-triangle stat-icon"></i>
      </div>
      <div class="stat-card danger" style="cursor:pointer" onclick="openInvModal('out')">
        <div class="stat-label">Out of Stock</div>
        <div class="stat-value"><%- outStk %></div>
        <div class="stat-sub">&nbsp;</div>
        <div class="inv-view-details">View Details <i class="fas fa-chevron-right" style="font-size:9px"></i></div>
        <i class="fas fa-box-open stat-icon"></i>
      </div>
    </div>

    <script type="application/json" id="outData"><%- outJSON %></script>
    <script type="application/json" id="lowData"><%- lowJSON %></script>

    <!-- Models Table -->
    <div class="card">
      <div class="card-title"><i class="fas fa-table"></i> Models (<%- models.length %>)</div>
      <div class="table-wrap">
        <table id="invTable">
          <thead>
            <tr>
              <th>Model</th>
              <th style="text-align:right">Total Qty</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
          <% models.forEach(function(model, idx) { %>

            <% var sc = model.status==='In Stock'?'badge-instock':model.status==='Low Stock'?'badge-low':'badge-out'; %>
            <% var hasVariants = model.variantCount > 1; %>

            <tr class="model-row" <%- hasVariants ? 'onclick="toggleModel('+idx+')" style="cursor:pointer"' : '' %>>
              <td>
                <div style="display:flex;align-items:center;gap:10px">
                  <% if (hasVariants) { %>
                  <i id="chev-<%- idx %>" class="fas fa-chevron-right"
                     style="font-size:10px;color:var(--text2);transition:transform .2s;flex-shrink:0"></i>
                  <% } else { %>
                  <span style="width:10px;display:inline-block;flex-shrink:0"></span>
                  <% } %>
                  <span style="font-weight:600"><%- model.name %></span>
                  <% if (hasVariants) { %>
                  <span style="font-size:11px;color:var(--text2);flex-shrink:0"><%- model.variantCount %> variants</span>
                  <% } %>
                </div>
              </td>
              <td style="text-align:right;font-weight:700;font-size:15px"><%- model.totalQty %></td>
              <td><span class="badge <%- sc %>"><%- model.status %></span></td>
            </tr>

            <% if (hasVariants) { %>
            <tr id="detail-<%- idx %>" style="display:none">
              <td colspan="3" style="padding:0 0 4px 0">
                <div style="background:var(--bg);border-bottom:1px solid var(--border);padding:8px 0 4px 42px">
                  <div style="padding:0 12px 8px 0">
                    <div style="position:relative">
                      <i class="fas fa-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:11px;color:var(--text2);pointer-events:none"></i>
                      <input id="search-<%- idx %>" type="text" placeholder="Search flavors…"
                        oninput="filterVariants(<%- idx %>)"
                        onclick="event.stopPropagation()"
                        style="width:100%;box-sizing:border-box;padding:7px 10px 7px 30px;font-size:12px;background:var(--card);border:1px solid var(--border);border-radius:7px;color:var(--text);outline:none">
                    </div>
                  </div>
                  <table style="width:100%">
                    <thead>
                      <tr>
                        <th style="font-size:10px;padding:6px 12px;background:transparent;border-bottom:1px solid var(--border)">Flavor / Variant</th>
                        <th style="font-size:10px;padding:6px 12px;text-align:right;background:transparent;border-bottom:1px solid var(--border)">Qty</th>
                        <th style="font-size:10px;padding:6px 12px;background:transparent;border-bottom:1px solid var(--border)">Status</th>
                      </tr>
                    </thead>
                    <tbody id="vbody-<%- idx %>">
                    <% model.variants.forEach(function(v) { %>
                      <% var vc = v.status==='In Stock'?'badge-instock':v.status==='Low Stock'?'badge-low':'badge-out'; %>
                      <tr style="border-bottom:1px solid rgba(217,119,87,.04)">
                        <td style="padding:7px 12px;font-size:13px;color:var(--text)"><%- v.name %></td>
                        <td style="padding:7px 12px;text-align:right;font-weight:600"><%- v.qty %></td>
                        <td style="padding:7px 12px"><span class="badge <%- vc %>"><%- v.status %></span></td>
                      </tr>
                    <% }) %>
                    </tbody>
                  </table>
                </div>
              </td>
            </tr>
            <% } %>

          <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<!-- Item Detail Modal — outside .main so position:fixed covers full viewport -->
<div id="invModal" style="display:none;position:fixed;inset:0;z-index:2000;align-items:center;justify-content:center;padding:20px;box-sizing:border-box">
  <!-- Backdrop -->
  <div onclick="closeInvModal()" style="position:absolute;inset:0;background:rgba(20,16,13,.72);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)"></div>
  <!-- Card -->
  <div style="position:relative;background:var(--card);border-radius:18px;width:min(520px,100%);max-height:82vh;display:flex;flex-direction:column;
              box-shadow:0 24px 80px rgba(0,0,0,.55),0 0 0 1px rgba(217,119,87,.18);
              animation:modalIn .22s cubic-bezier(.34,1.2,.64,1)">
    <!-- Header -->
    <div style="display:flex;align-items:center;justify-content:space-between;padding:20px 22px 16px;border-bottom:1px solid var(--border);flex-shrink:0">
      <div>
        <div id="invModalTitle" style="font-size:16px;font-weight:700;letter-spacing:.1px"></div>
        <div id="invModalSub" style="font-size:12px;color:var(--text2);margin-top:3px"></div>
      </div>
      <button onclick="closeInvModal()"
        style="background:rgba(217,119,87,.1);border:none;color:var(--text2);cursor:pointer;font-size:14px;
               padding:0;width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;
               transition:background .15s"
        onmouseover="this.style.background='rgba(217,119,87,.25)'" onmouseout="this.style.background='rgba(217,119,87,.1)'">
        <i class="fas fa-xmark"></i>
      </button>
    </div>
    <!-- Body -->
    <div style="overflow-y:auto;padding:4px 22px 22px">
      <table style="width:100%;margin-top:12px;border-collapse:collapse">
        <thead>
          <tr>
            <th style="font-size:11px;padding:8px 0;text-align:left;border-bottom:1px solid var(--border);color:var(--text2);font-weight:600;text-transform:uppercase;letter-spacing:.6px">Item / Flavor</th>
            <th style="font-size:11px;padding:8px 0;text-align:right;border-bottom:1px solid var(--border);color:var(--text2);font-weight:600;text-transform:uppercase;letter-spacing:.6px">Qty</th>
          </tr>
        </thead>
        <tbody id="invModalBody"></tbody>
      </table>
    </div>
  </div>
</div>

<style>
@keyframes modalIn {
  from { opacity:0; transform:scale(.93) translateY(12px); }
  to   { opacity:1; transform:scale(1)  translateY(0); }
}
</style>

<script>
function toggleModel(idx) {
  var detail = document.getElementById('detail-' + idx);
  var chev   = document.getElementById('chev-' + idx);
  var open   = detail.style.display === 'none';
  detail.style.display = open ? 'table-row' : 'none';
  chev.style.transform = open ? 'rotate(90deg)' : '';
  if (open) {
    var inp = document.getElementById('search-' + idx);
    if (inp) { inp.value = ''; filterVariants(idx); setTimeout(function(){ inp.focus(); }, 50); }
  }
}

function filterVariants(idx) {
  var query = document.getElementById('search-' + idx).value.toLowerCase().trim();
  var rows  = document.getElementById('vbody-' + idx).querySelectorAll('tr');
  rows.forEach(function(row) {
    var name = row.cells[0] ? row.cells[0].textContent.toLowerCase() : '';
    row.style.display = (!query || name.includes(query)) ? '' : 'none';
  });
}

var OUT_ITEMS = JSON.parse(document.getElementById('outData').textContent);
var LOW_ITEMS = JSON.parse(document.getElementById('lowData').textContent);

function openInvModal(type) {
  var items = type === 'out' ? OUT_ITEMS : LOW_ITEMS;
  var title = type === 'out' ? 'Out of Stock Items' : 'Low Stock Items';
  var icon  = type === 'out' ? 'fa-box-open' : 'fa-exclamation-triangle';
  var color = type === 'out' ? 'var(--danger)' : 'var(--warn)';
  var sub   = type === 'out'
    ? items.length + ' items with zero quantity'
    : items.length + ' items with qty below 100';

  document.getElementById('invModalTitle').innerHTML =
    '<i class="fas ' + icon + '" style="margin-right:8px;color:' + color + '"></i>' + title;
  document.getElementById('invModalSub').textContent = sub;

  var tbody = document.getElementById('invModalBody');
  tbody.innerHTML = '';
  if (items.length === 0) {
    tbody.innerHTML = '<tr><td colspan="2" style="text-align:center;padding:32px;color:var(--text2);font-size:13px">' +
      '<i class="fas fa-check-circle" style="color:var(--accent2);font-size:24px;display:block;margin-bottom:8px"></i>All clear!</td></tr>';
  } else {
    items.forEach(function(item) {
      var cls = type === 'out' ? 'txt-danger' : 'txt-warn';
      var dot = type === 'out' ? 'var(--danger)' : 'var(--warn)';
      tbody.innerHTML +=
        '<tr style="border-bottom:1px solid rgba(217,119,87,.07);transition:background .12s" ' +
        'onmouseover="this.style.background=\'rgba(217,119,87,.05)\'" onmouseout="this.style.background=\'\'">' +
        '<td style="padding:10px 0;font-size:13px">' +
          '<i class="fas fa-circle" style="font-size:6px;color:' + dot + ';margin-right:8px;vertical-align:middle"></i>' +
          item.name +
        '</td>' +
        '<td style="padding:10px 0;text-align:right;font-weight:700;font-size:14px" class="' + cls + '">' + item.qty + '</td></tr>';
    });
  }
  document.getElementById('invModal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function closeInvModal() {
  document.getElementById('invModal').style.display = 'none';
  document.body.style.overflow = '';
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeInvModal();
});
</script>

<%- include('partials/foot') %>
