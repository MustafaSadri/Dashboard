<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main">
  <%- include('partials/header', {pageTitle: 'Commission'}) %>
  <div class="page">
    <%
      var R = report, T = report.totals, E = report.employee, ORD = E.basis === 'order_payments', PCS = E.basis === 'model_pcs', GR = E.basis === 'shipment_growth', PP = E.perPcs;
      var pcsFmt = function (n) { return n.toLocaleString('en-US', { maximumFractionDigits: 2 }); };
      var monthName = function (m) { var p = m.split('-'); return new Date(+p[0], +p[1] - 1, 1).toLocaleString('en', { month: 'short', year: 'numeric' }); };
      var plural = function (n, w) { return n + ' ' + w + (n === 1 ? '' : 's'); };
      var rub = function (n, d) { return n == null ? '—' : (n < 0 ? '−₽' : '₽') + Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 }); };
      var monthLabel = (months.find(function (m) { return m.key === R.month; }) || { label: R.month }).label;
    %>
    <style>
      .cm-tabs { display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap; align-items:center; }
      .cm-tab { padding:9px 16px; border-radius:10px; border:1px solid var(--border); font-size:13px; font-weight:600; color:var(--text2); background:var(--bg2); text-decoration:none; }
      .cm-tab.on { background:linear-gradient(135deg,#D97757,#5a52e0); color:#fff; border-color:transparent; }
      .cm-month { margin-left:auto; padding:9px 12px; border-radius:10px; border:1.5px solid var(--border); background:var(--bg2); color:var(--text); font-size:14px; font-weight:600; outline:none; }
      .cm-tbl { width:100%; border-collapse:collapse; }
      .cm-tbl th { text-align:right; font-size:10.5px; color:var(--text2); text-transform:uppercase; letter-spacing:.5px; padding:9px 10px; border-bottom:1px solid var(--border); white-space:nowrap; }
      .cm-tbl td { text-align:right; padding:10px; border-bottom:1px solid rgba(217,119,87,.06); font-size:13px; white-space:nowrap; }
      .cm-tbl .l { text-align:left; }
      .cm-tbl tfoot td { font-weight:800; border-top:2px solid var(--border); border-bottom:none; font-size:14px; }
      .cm-emps { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:18px; }
      .cm-emp { padding:8px 16px; border-radius:999px; border:1.5px solid var(--border); background:transparent; color:var(--text2); font-size:13px; font-weight:700; text-decoration:none; }
      .cm-emp.on { background:var(--accent); border-color:var(--accent); color:#fff; }
      .cm-custs { display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:8px; }
      .cm-cust { display:flex; align-items:center; gap:10px; padding:9px 12px; border:1px solid var(--border); border-radius:9px; font-size:13px; cursor:pointer; }
      .cm-cust.on { border-color:var(--accent); background:rgba(217,119,87,.08); }
      .cm-cust input { width:16px; height:16px; accent-color:var(--accent); flex:none; }
      .cm-cust small { display:block; font-size:10.5px; color:var(--text2); margin-top:1px; }
      .cm-rate { font-size:10.5px; font-weight:700; padding:2px 8px; border-radius:8px; background:rgba(79,174,138,.14); color:var(--accent2); }
      .cm-rate.sp { background:rgba(64,160,255,.13); color:#2f8de4; }
      .cm-chips { display:flex; gap:6px; flex-wrap:wrap; margin-left:auto; }
      .cm-chips[hidden] { display:none; }
      .cm-chip { padding:6px 12px; border-radius:999px; border:1.5px solid var(--border); background:transparent; color:var(--text2); font-size:12px; font-weight:700; cursor:pointer; }
      .cm-chip.on { background:var(--accent); border-color:var(--accent); color:#fff; }
      .cm-cmt { max-width:260px; overflow:hidden; text-overflow:ellipsis; color:var(--text2); font-size:12px; }
      .cm-note { margin-top:12px; padding:10px 13px; border-radius:9px; font-size:12.5px; background:var(--bg3); color:var(--text2); line-height:1.6; }
      @media (max-width: 760px) { .cm-month { margin-left:0; width:100%; } .cm-hide-sm { display:none; } }
    </style>

    <div class="cm-tabs">
      <a class="cm-tab" href="/admin/commission?month=<%= R.month %>"><i class="fas fa-handshake"></i> Babylon Commission</a>
      <span class="cm-tab on"><i class="fas fa-users"></i> Managers Commission</span>
      <select class="cm-month" onchange="location.href='/admin/commission/staff/<%= R.key %>?month='+this.value" aria-label="Month">
        <% months.forEach(function (m) { %><option value="<%= m.key %>" <%= m.key === R.month ? 'selected' : '' %>><%= m.label %></option><% }) %>
      </select>
    </div>

    <div class="cm-emps">
      <% Object.keys(staff).forEach(function (k) { %>
        <a class="cm-emp <%= k === R.key ? 'on' : '' %>" href="/admin/commission/staff/<%= k %>?month=<%= R.month %>"><%= staff[k].name %><%= staff[k].ownerName && staff[k].ownerName.indexOf(staff[k].name) !== 0 ? ' (' + staff[k].ownerName + ')' : '' %></a>
      <% }) %>
    </div>

    <% if (GR) { var G = R.growth, RULE = E.growth, num = function (n) { return n.toLocaleString('en-US'); }; %>
    <div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));margin-bottom:20px">
      <div class="stat-card"><div class="stat-label">Total pcs shipped</div><div class="stat-value"><%= num(T.pcs) %></div><div class="stat-sub"><%= plural(T.count, 'shipment') %> · <%= monthLabel %></div><i class="fas fa-truck stat-icon"></i></div>
      <div class="stat-card"><div class="stat-label"><%= RULE.label %> pcs</div><div class="stat-value"><%= num(G.growthPcs) %></div><div class="stat-sub">target <%= num(G.target) %></div><i class="fas fa-bullseye stat-icon"></i></div>
      <div class="stat-card success"><div class="stat-label"><%= E.name %>'s commission</div><div class="stat-value" style="color:var(--accent2)"><%- rub(T.total, 2) %></div><div class="stat-sub"><%= monthLabel %></div><i class="fas fa-user-tie stat-icon"></i></div>
    </div>

    <div class="card">
      <div class="card-title"><i class="fas fa-calculator"></i> Commission — <%= E.name %>, <%= monthLabel %></div>
      <div style="overflow-x:auto">
        <table class="cm-tbl">
          <thead><tr><th class="l">Pcs</th><th>Quantity</th><th>Rate</th><th>Commission</th></tr></thead>
          <tbody>
            <tr><td class="l"><b><%= RULE.label %> above target</b></td><td><%= num(G.over) %></td><td><span class="cm-rate sp">₽<%= RULE.overRub %>/pc</span></td><td style="color:var(--accent2);font-weight:700"><%- rub(G.overCommission, 2) %></td></tr>
            <tr><td class="l"><b>All other pcs</b></td><td><%= num(G.rest) %></td><td><span class="cm-rate">₽<%= E.rub %>/pc</span></td><td style="color:var(--accent2);font-weight:700"><%- rub(G.restCommission, 2) %></td></tr>
          </tbody>
          <tfoot><tr><td class="l">Total</td><td><%= num(T.pcs) %></td><td></td><td style="color:var(--accent2)"><%- rub(T.total, 2) %></td></tr></tfoot>
        </table>
      </div>
    </div>

    <div class="card" style="margin-top:20px">
      <div class="card-title"><i class="fas fa-boxes-stacked"></i> Pcs shipped by model — <%= monthLabel %></div>
      <div style="overflow-x:auto">
        <table class="cm-tbl">
          <thead><tr><th class="l">Model</th><th>Pcs</th><th><%= RULE.label %></th></tr></thead>
          <tbody>
            <% R.models.forEach(function (m) { %>
              <tr><td class="l"><%= m.model %></td><td><%= num(m.pcs) %></td><td><% if (m.counted) { %><span class="cm-rate sp">Yes</span><% } else { %>—<% } %></td></tr>
            <% }) %>
          </tbody>
          <tfoot><tr><td class="l">Total</td><td><%= num(T.pcs) %></td><td></td></tr></tfoot>
        </table>
      </div>
    </div>
    <% } else { %>
    <div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));margin-bottom:20px">
      <% if (PCS) { %>
        <div class="stat-card"><div class="stat-label"><%= PP.label %> pcs sold</div><div class="stat-value"><%= T.pcs.toLocaleString('en-US') %></div><div class="stat-sub">in <%= plural(T.count, 'sales order') %> (all owners) · <%= monthLabel %></div><i class="fas fa-box stat-icon"></i></div>
        <div class="stat-card"><div class="stat-label"><%= PP.label %> sales</div><div class="stat-value"><%- rub(T.amount) %></div><div class="stat-sub"><%= monthLabel %></div><i class="fas fa-file-invoice stat-icon"></i></div>
      <% } else if (ORD) { %>
        <div class="stat-card"><div class="stat-label">Payments received</div><div class="stat-value"><%- rub(T.amount) %></div><div class="stat-sub">on <%= E.ownerName %>'s sales orders · <%= monthLabel %></div><i class="fas fa-file-invoice stat-icon"></i></div>
        <% if (PP) { %><div class="stat-card"><div class="stat-label"><%= PP.label %> bonus</div><div class="stat-value"><%- rub(T.bonus) %></div><div class="stat-sub"><%= pcsFmt(T.pcs) %> pcs × ₽<%= PP.rub %></div><i class="fas fa-box stat-icon"></i></div><% } %>
      <% } else { %>
        <div class="stat-card"><div class="stat-label">Payments received</div><div class="stat-value"><%- rub(T.amount) %></div><div class="stat-sub"><%= plural(T.count, 'payment') %> · <%= E.office %> · <%= monthLabel %></div><i class="fas fa-money-bill-transfer stat-icon"></i></div>
        <% R.groups.forEach(function (g) { if (!(E.special || {})[g.group]) return; %>
          <div class="stat-card"><div class="stat-label"><%= g.group %> payments</div><div class="stat-value"><%- rub(g.amount) %></div><div class="stat-sub"><%= plural(g.count, 'payment') %> × <%= g.rate %>%</div><i class="fas fa-user stat-icon"></i></div>
        <% }) %>
      <% } %>
      <div class="stat-card success"><div class="stat-label"><%= E.name %>'s commission</div><div class="stat-value" style="color:var(--accent2)"><%- rub(T.total, 2) %></div><div class="stat-sub"><%= monthLabel %></div><i class="fas fa-user-tie stat-icon"></i></div>
    </div>

    <div class="card">
      <div class="card-title"><i class="fas fa-calculator"></i> Commission — <%= E.name %>, <%= monthLabel %></div>
      <div style="overflow-x:auto">
        <table class="cm-tbl">
          <% if (!PCS) { %><thead><tr><th class="l">Customers</th><th>Payments</th><th>Amount received</th><th>Rate</th><th>Commission</th></tr></thead><% } else { %><thead><tr><th class="l">Model</th><th>Orders</th><th>PCS</th><th>Rate</th><th>Commission</th></tr></thead><% } %>
          <tbody>
            <% if (!R.groups.length) { %>
              <tr><td colspan="5" style="text-align:center;padding:26px;color:var(--text2)">No <%= PCS ? PP.label + ' sales orders' : ORD ? 'payments on ' + E.ownerName + ' sales orders' : E.office + ' payments' %> in <%= monthLabel %>.</td></tr>
            <% } %>
            <% if (!PCS) R.groups.forEach(function (g) { %>
              <tr>
                <td class="l"><b><%= g.group %></b></td>
                <td><%= g.count %></td>
                <td><%- rub(g.amount, 2) %></td>
                <td><span class="cm-rate <%= (E.special || {})[g.group] ? 'sp' : '' %>"><%= g.rate %>%</span></td>
                <td style="color:var(--accent2);font-weight:700"><%- rub(g.commission, 2) %></td>
              </tr>
            <% }) %>
            <% if (PP) { %>
              <tr>
                <td class="l"><b><%= PP.label %> pcs</b></td>
                <td><%= PCS ? T.count : '' %></td>
                <td><%= pcsFmt(T.pcs) %> pcs</td>
                <td><span class="cm-rate sp">₽<%= PP.rub %>/pc</span></td>
                <td style="color:var(--accent2);font-weight:700"><%- rub(T.bonus, 2) %></td>
              </tr>
            <% } %>
          </tbody>
          <tfoot><tr><td class="l">Total</td><td><%= T.count %></td><td><%= PCS ? T.pcs.toLocaleString('en-US') + ' pcs' : '' %><%- PCS ? '' : rub(T.amount, 2) %></td><td></td><td style="color:var(--accent2)"><%- rub(T.total, 2) %></td></tr></tfoot>
        </table>
      </div>
    </div>

    <% if (R.customers) { %>
    <div class="card" style="margin-top:20px">
      <div class="card-title"><i class="fas fa-user-plus"></i> New customers — <%= E.newCustomer.rate %>% for <%= E.newCustomer.months %> months</div>
      <div class="cm-custs" id="cmCusts" data-key="<%= R.key %>" data-month="<%= R.month %>">
        <% R.customers.forEach(function (c) { %>
          <label class="cm-cust <%= c.active ? 'on' : '' %>">
            <input type="checkbox" data-name="<%= c.name %>" <%= c.start ? 'checked' : '' %>>
            <span><%= c.name %><% if (c.start) { %><small><%= E.newCustomer.rate %>%: <%= monthName(c.start) %> – <%= monthName(c.until) %></small><% } %></span>
          </label>
        <% }) %>
      </div>
    </div>
    <% } %>

    <div class="card" style="margin-top:20px">
      <div class="card-title" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span><i class="fas fa-list"></i> <%= PCS ? 'Sales orders' : 'Payments' %> — <%= monthLabel %></span>
        <div class="cm-chips" <%= R.groups.length < 2 ? "hidden" : "" %>>
          <button class="cm-chip on" data-g="">All (<%= T.count %>)</button>
          <% R.groups.forEach(function (g) { %><button class="cm-chip" data-g="<%= g.group %>"><%= g.group %> (<%= g.count %>)</button><% }) %>
        </div>
      </div>
      <div style="overflow-x:auto">
        <table class="cm-tbl" id="cmPay">
          <thead><tr><th class="l">No.</th><th class="l">Date</th><% if (ORD) { %><th class="l">Order</th><% } %><th class="l">Counterparty</th><th class="l cm-hide-sm"><%= ORD ? 'Linked via' : PCS ? 'Status' : 'Comment' %></th><% if (PCS) { %><th class="l cm-hide-sm">Owner</th><% } %><th><%= PCS ? PP.label + ' amount' : 'Amount' %></th><% if (!PCS) { %><th>Rate</th><th>Commission</th><% } %><% if (PP) { %><th><%= PP.label %> pcs</th><th><%= PCS ? 'Commission' : 'Bonus' %></th><% if (!PCS) { %><th>Total</th><% } %><% } %></tr></thead>
          <tbody>
            <% R.payments.slice().reverse().forEach(function (p) { %>
              <tr data-g="<%= p.group %>">
                <td class="l"><%= p.no %><% if (p.type === 'Cash') { %> <span class="cm-rate">cash</span><% } %></td>
                <td class="l"><%= p.date.replace('T', ' ') %></td>
                <% if (ORD) { %><td class="l"><%= p.order %></td><% } %>
                <td class="l"><%= p.customer %></td>
                <td class="l cm-hide-sm"><div class="cm-cmt" title="<%= p.comment %>"><%= p.comment %></div></td>
                <% if (PCS) { %><td class="l cm-hide-sm"><%= p.owner %></td><% } %>
                <td><%- rub(p.amount, 2) %></td>
                <% if (!PCS) { %><td><span class="cm-rate <%= (E.special || {})[p.group] ? 'sp' : '' %>"><%= p.rate %>%</span></td>
                <td style="color:var(--accent2);font-weight:700"><%- rub(p.commission, 2) %></td><% } %>
                <% if (PP) { %><td><%= p.pcs ? pcsFmt(p.pcs) : '—' %></td><td <%- PCS ? 'style="color:var(--accent2);font-weight:700"' : '' %>><%- p.bonus ? rub(p.bonus, ORD ? 2 : 0) : '—' %></td><% if (!PCS) { %><td style="color:var(--accent2);font-weight:700"><%- rub(p.total, 2) %></td><% } %><% } %>
              </tr>
            <% }) %>
          </tbody>
          <tfoot><tr><td class="l" colspan="<%= PCS || ORD ? 5 : 4 %>" id="cmPayLbl">Total</td><td id="cmPayAmt"><%- rub(T.amount, 2) %></td><% if (!PCS) { %><td></td><td id="cmPayCom" style="color:var(--accent2)"><%- rub(T.commission, 2) %></td><% } %><% if (PP) { %><td id="cmPayPcs"><%= pcsFmt(T.pcs) %></td><td id="cmPayBonus" <%- PCS ? 'style="color:var(--accent2)"' : '' %>><%- rub(T.bonus, ORD ? 2 : 0) %></td><% if (!PCS) { %><td id="cmPayTot" style="color:var(--accent2)"><%- rub(T.total, 2) %></td><% } %><% } %></tr></tfoot>
        </table>
      </div>
    </div>
    <% } %>
  </div>
</div>
<%- include('partials/foot') %>
<script>
(function () {
  var box = document.getElementById('cmCusts');
  if (box) box.addEventListener('change', function (e) {
    var cb = e.target;
    box.querySelectorAll('input').forEach(function (i) { i.disabled = true; });
    fetch('/api/admin/commission/new-customer', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key: box.dataset.key, month: box.dataset.month, customer: cb.dataset.name, on: cb.checked }),
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (!d.ok) throw new Error(d.error || 'Failed');
      location.reload();
    }).catch(function (err) {
      cb.checked = !cb.checked;
      box.querySelectorAll('input').forEach(function (i) { i.disabled = false; });
      window.alert('Could not save: ' + err.message);
    });
  });
  var P = <%- JSON.stringify(R.payments.map(function (p) { return { g: p.group, a: p.amount, c: p.commission, n: p.pcs, b: p.bonus, t: p.total }; })) %>;
  function rub(n) { return '₽' + Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  document.querySelectorAll('.cm-chip').forEach(function (chip) {
    chip.addEventListener('click', function () {
      var g = chip.dataset.g;
      document.querySelectorAll('.cm-chip').forEach(function (c) { c.classList.toggle('on', c === chip); });
      document.querySelectorAll('#cmPay tbody tr').forEach(function (tr) { tr.hidden = !!g && tr.dataset.g !== g; });
      var rows = P.filter(function (p) { return !g || p.g === g; });
      document.getElementById('cmPayLbl').textContent = g ? 'Total — ' + g : 'Total';
      document.getElementById('cmPayAmt').textContent = rub(rows.reduce(function (a, p) { return a + p.a; }, 0));
      var set = function (id, v) { var el = document.getElementById(id); if (el) el.textContent = v; };
      set('cmPayCom', rub(rows.reduce(function (a, p) { return a + p.c; }, 0)));
      set('cmPayPcs', rows.reduce(function (a, p) { return a + p.n; }, 0).toLocaleString('en-US', { maximumFractionDigits: 2 }));
      set('cmPayBonus', rub(rows.reduce(function (a, p) { return a + p.b; }, 0)));
      set('cmPayTot', rub(rows.reduce(function (a, p) { return a + p.t; }, 0)));
    });
  });
})();
</script>
