<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main">
  <%- include('partials/header', {pageTitle: 'Alerts'}) %>
  <div class="page">

    <div class="stats-grid">
      <div class="stat-card danger"><div class="stat-label">Total Alerts</div><div class="stat-value"><%- total %></div><i class="fas fa-bell stat-icon"></i></div>
    </div>

    <div class="card">
      <div class="card-title"><i class="fas fa-bell"></i> All Alerts</div>
      <% if(alerts.length===0){ %>
        <div class="empty"><i class="fas fa-check-circle" style="color:var(--accent2)"></i>All clear — no active alerts</div>
      <% } %>
      <% alerts.forEach(function(a){ %>
      <div class="alert-item">
        <div class="alert-icon <%- a.t %>"><i class="fas <%- a.i %>"></i></div>
        <div style="flex:1">
          <div class="alert-title"><%- a.title %></div>
          <div class="alert-desc"><%- a.desc %></div>
        </div>
        <div class="alert-time"><%- a.time %></div>
      </div>
      <% }) %>
    </div>

  </div>
</div>
<%- include('partials/foot') %>
