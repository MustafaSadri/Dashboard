<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main">
  <%- include('partials/header', {pageTitle: 'Suppliers'}) %>
  <div class="page">

    <div class="stats-grid">
      <div class="stat-card"><div class="stat-label">Total Suppliers</div><div class="stat-value"><%- total %></div><i class="fas fa-industry stat-icon"></i></div>
    </div>

    <div class="card">
      <div class="card-title"><i class="fas fa-industry"></i> Supplier List</div>
      <% if(suppliers.length===0){ %>
        <div class="empty"><i class="fas fa-industry"></i>No suppliers found</div>
      <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr>
            <th>Name</th><th>Phone</th><th>Email</th><th>Type</th><th>INN / Tax ID</th><th>Code</th>
          </tr></thead>
          <tbody>
          <% suppliers.forEach(function(s){ %>
            <tr>
              <td><strong><%- s.name %></strong></td>
              <td class="muted"><%- s.phone %></td>
              <td class="muted"><%- s.email %></td>
              <td class="muted"><%- s.type %></td>
              <td class="muted"><%- s.inn %></td>
              <td class="muted"><%- s.code %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

  </div>
</div>
<%- include('partials/foot') %>
