<!-- Shared "what's in this order" popup — click any order row anywhere in the
     app to open it. Include this partial once per page, then trigger with
     onclick="showOrderItems(orderId)". -->
<div id="oiModal" style="display:none;position:fixed;inset:0;z-index:1000;align-items:center;justify-content:center;padding:20px">
  <div onclick="closeOrderItems()" style="position:absolute;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(3px)"></div>
  <div style="position:relative;background:var(--bg2);border:1px solid var(--border);border-radius:14px;
              width:100%;max-width:560px;max-height:82vh;display:flex;flex-direction:column;
              box-shadow:0 24px 80px rgba(0,0,0,.6)">
    <div style="padding:18px 22px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0">
      <div>
        <div style="font-size:15px;font-weight:700" id="oiTitle">Order</div>
        <div style="font-size:12px;color:var(--text2);margin-top:1px" id="oiSub"></div>
      </div>
      <button onclick="closeOrderItems()"
        style="width:30px;height:30px;border-radius:7px;background:var(--bg3);border:1px solid var(--border);
               color:var(--text2);cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center">
        <i class="fas fa-xmark"></i>
      </button>
    </div>
    <div style="overflow-y:auto;flex:1" id="oiBody">
      <div style="text-align:center;padding:48px 20px;color:var(--text2)">
        <i class="fas fa-spinner fa-spin" style="font-size:20px;display:block;margin-bottom:10px"></i>
        Loading…
      </div>
    </div>
  </div>
</div>

<script>
function _oiFmt(n) {
  return '₽' + Math.round(n || 0).toLocaleString();
}

function showOrderItems(orderId) {
  var modal = document.getElementById('oiModal');
  var body  = document.getElementById('oiBody');
  document.getElementById('oiTitle').textContent = 'Loading order…';
  document.getElementById('oiSub').textContent = '';
  body.innerHTML = '<div style="text-align:center;padding:48px 20px;color:var(--text2)">' +
    '<i class="fas fa-spinner fa-spin" style="font-size:20px;display:block;margin-bottom:10px"></i>Loading…</div>';
  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';

  fetch('/api/order/' + encodeURIComponent(orderId) + '/items')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (!data.ok) throw new Error(data.error || 'Failed to load order');
      document.getElementById('oiTitle').textContent = data.name;
      document.getElementById('oiSub').textContent = data.customer + ' · ' + (data.date || '—');

      if (!data.items.length) {
        body.innerHTML = '<div style="text-align:center;padding:48px 20px;color:var(--text2)">' +
          '<i class="fas fa-box-open" style="font-size:24px;display:block;margin-bottom:10px;opacity:.4"></i>No items found</div>';
        return;
      }

      var rows = data.items.map(function(it) {
        return '<tr style="border-bottom:1px solid rgba(217,119,87,.06)">' +
          '<td style="padding:10px 14px;font-size:13px;font-weight:600">' + it.model + '</td>' +
          '<td style="padding:10px 14px;font-size:13px;text-align:center">' + it.pcs + '</td>' +
          '<td style="padding:10px 14px;font-size:13px;text-align:right;color:var(--text2)">' + _oiFmt(it.price) + '</td>' +
          '<td style="padding:10px 14px;font-size:13px;text-align:right;font-weight:600;color:var(--accent2)">' + _oiFmt(it.amount) + '</td>' +
          '</tr>';
      }).join('');

      body.innerHTML =
        '<table style="width:100%;border-collapse:collapse">' +
        '<thead><tr>' +
        '<th style="background:var(--bg3);padding:9px 14px;text-align:left;font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px;border-bottom:1px solid var(--border);position:sticky;top:0">Model</th>' +
        '<th style="background:var(--bg3);padding:9px 14px;text-align:center;font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px;border-bottom:1px solid var(--border);position:sticky;top:0">PCS</th>' +
        '<th style="background:var(--bg3);padding:9px 14px;text-align:right;font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px;border-bottom:1px solid var(--border);position:sticky;top:0">Price/pc</th>' +
        '<th style="background:var(--bg3);padding:9px 14px;text-align:right;font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px;border-bottom:1px solid var(--border);position:sticky;top:0">Amount</th>' +
        '</tr></thead><tbody>' + rows + '</tbody>' +
        '<tfoot><tr>' +
        '<td colspan="3" style="padding:10px 14px;font-size:12px;font-weight:700;text-align:right;border-top:2px solid var(--border)">Total</td>' +
        '<td style="padding:10px 14px;font-size:13px;font-weight:700;text-align:right;color:var(--accent2);border-top:2px solid var(--border)">' + _oiFmt(data.total) + '</td>' +
        '</tr></tfoot></table>';
    })
    .catch(function(e) {
      document.getElementById('oiTitle').textContent = 'Order';
      body.innerHTML = '<div style="text-align:center;padding:48px 20px;color:var(--danger)">' +
        '<i class="fas fa-triangle-exclamation" style="font-size:22px;display:block;margin-bottom:10px"></i>' +
        (e.message || 'Failed to load order') + '</div>';
    });
}

function closeOrderItems() {
  document.getElementById('oiModal').style.display = 'none';
  document.body.style.overflow = '';
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    var m = document.getElementById('oiModal');
    if (m && m.style.display !== 'none') closeOrderItems();
  }
});
</script>
