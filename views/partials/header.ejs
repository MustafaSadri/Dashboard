<div class="topbar">
  <button class="hamburger" onclick="toggleSidebar()" aria-label="Toggle menu">
    <i class="fas fa-bars"></i>
  </button>
  <div class="topbar-title"><%- pageTitle %></div>
  <div style="flex:1"></div>
  <div class="topbar-date" id="topbarDate"></div>
  <div class="topbar-time" style="margin-left:14px" id="topbarTime"></div>
  <script>
    (function(){
      function pad(n){ return String(n).padStart(2,'0'); }
      function tick(){
        var d = new Date();
        var months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
        document.getElementById('topbarDate').textContent =
          pad(d.getDate()) + ' ' + months[d.getMonth()] + ' ' + d.getFullYear();
        var h = d.getHours(), m = pad(d.getMinutes());
        var ampm = h >= 12 ? 'pm' : 'am';
        h = h % 12 || 12;
        document.getElementById('topbarTime').textContent = pad(h) + ':' + m + ' ' + ampm;
      }
      tick();
      setInterval(tick, 60000);
    })();
  </script>
  <div class="topbar-bell" onclick="toggleAlertPanel(event)" title="Stock Alerts (below 50)">
    <i class="fas fa-bell" style="font-size:13px"></i>
    <% var _alertCount = (typeof stockAlertCount !== 'undefined' ? stockAlertCount : 0); %>
    <% if (_alertCount > 0) { %>
    <span class="notif-badge"><%- _alertCount > 99 ? '99+' : _alertCount %></span>
    <% } %>
  </div>
  <button id="themeToggle" onclick="toggleTheme()" title="Toggle light/dark theme"
    style="background:none;border:1px solid var(--border);color:var(--text2);border-radius:8px;
           padding:6px 10px;cursor:pointer;font-size:13px;transition:all .2s;margin-left:8px">
    <i class="fas fa-sun"></i>
  </button>
  <a href="javascript:void(0)" class="topbar-refresh" id="forceRefreshBtn" onclick="forceRefreshSync()" title="Sync latest data from MoySklad">
    <i class="fas fa-rotate-right" id="forceRefreshIcon"></i>
  </a>
  <a href="/logout" title="Sign out"
    style="background:none;border:1px solid var(--border);color:var(--text2);border-radius:8px;
           padding:6px 10px;cursor:pointer;font-size:13px;transition:all .2s;margin-left:8px;
           text-decoration:none;display:inline-flex;align-items:center;gap:6px;">
    <i class="fas fa-right-from-bracket"></i>
  </a>
</div>

<% if (typeof syncAlert !== 'undefined' && syncAlert) { %>
<div style="background:rgba(229,72,77,.12);border-bottom:1px solid rgba(229,72,77,.35);
            padding:10px 28px;display:flex;align-items:center;gap:10px;font-size:13px;color:var(--text)">
  <i class="fas fa-triangle-exclamation" style="color:var(--danger);font-size:14px;flex-shrink:0"></i>
  <span><%- syncAlert.message %></span>
</div>
<% } %>

<!-- Stock Alert Panel -->
<div class="alert-panel" id="alertPanel">
  <div class="alert-panel-hdr">
    <div>
      <div style="font-size:13px;font-weight:700">Stock Alerts</div>
      <div style="font-size:11px;color:var(--text2);margin-top:1px"><%- _alertCount %> items below 50 qty</div>
    </div>
    <button onclick="closeAlertPanel()" style="background:none;border:none;color:var(--text2);cursor:pointer;font-size:14px;padding:2px 4px">
      <i class="fas fa-xmark"></i>
    </button>
  </div>
  <% var _alerts = (typeof stockAlerts !== 'undefined' ? stockAlerts : []); %>
  <% if (_alerts.length === 0) { %>
  <div style="padding:24px;text-align:center;color:var(--text2);font-size:13px">
    <i class="fas fa-check-circle" style="color:var(--accent2);font-size:22px;display:block;margin-bottom:8px"></i>
    All items are well stocked
  </div>
  <% } else { %>
  <% _alerts.forEach(function(item) { %>
  <%   var isOut = item.qty <= 0; %>
  <%   var isLow = item.qty > 0 && item.qty <= 5; %>
  <%   var dotColor = isOut ? 'var(--danger)' : (isLow ? 'var(--warn)' : 'rgba(136,145,181,.4)'); %>
  <%   var qtyCls  = isOut ? 'txt-danger'    : (isLow ? 'txt-warn'    : 'txt-muted'); %>
  <div class="alert-panel-row">
    <div style="font-size:12px;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1">
      <i class="fas fa-circle" style="font-size:7px;margin-right:5px;color:<%- dotColor %>"></i>
      <%- item.name %>
    </div>
    <div class="<%- qtyCls %>" style="font-size:12px;font-weight:700;flex-shrink:0;margin-left:8px">
      <%- item.qty %>
    </div>
  </div>
  <% }) %>
  <% } %>
</div>

<script>
function toggleAlertPanel(e) {
  e.stopPropagation();
  var p = document.getElementById('alertPanel');
  p.style.display = p.style.display === 'block' ? 'none' : 'block';
}
function closeAlertPanel() {
  document.getElementById('alertPanel').style.display = 'none';
}
document.addEventListener('click', function(e) {
  var p = document.getElementById('alertPanel');
  if (p && p.style.display === 'block' && !p.contains(e.target)) {
    p.style.display = 'none';
  }
});

// ── Force refresh: sync latest data from MoySklad, then reload ──────────
// Used by the topbar refresh button and by the pull-to-refresh gesture
// below — both just need "go get the newest data right now" instead of
// waiting for the background 2-minute cron tick.
var _forceRefreshing = false;
function forceRefreshSync() {
  if (_forceRefreshing) return;
  _forceRefreshing = true;
  var icon = document.getElementById('forceRefreshIcon');
  if (icon) icon.classList.add('fa-spin');
  fetch('/api/ms/sync', { method: 'POST' })
    .catch(function() { /* still reload below even if the sync call itself failed */ })
    .then(function() { location.reload(); });
}

// ── Pull-to-refresh (mobile) ──────────────────────────────────────────────
// Regular mobile Safari's own pull-down gesture just does a plain page
// reload (no way to hook into it from page JS), so this replaces it with a
// custom gesture: pulling down from the very top of the page runs the same
// force-sync as the topbar button instead of a bare reload.
(function() {
  var startY = 0, pulling = false, dragging = false, indicator, iconEl, textEl;
  var THRESHOLD = 70;

  function ensureIndicator() {
    if (indicator) return;
    indicator = document.createElement('div');
    indicator.style.cssText = 'position:fixed;top:0;left:0;right:0;height:0;overflow:hidden;' +
      'display:flex;align-items:center;justify-content:center;gap:6px;' +
      'background:var(--bg2);color:var(--accent);font-size:12px;font-weight:600;z-index:2000';
    indicator.innerHTML = '<i class="fas fa-arrow-down" id="ptrIcon"></i><span id="ptrText">Pull to sync latest data</span>';
    document.body.appendChild(indicator);
    iconEl = document.getElementById('ptrIcon');
    textEl = document.getElementById('ptrText');
  }

  document.addEventListener('touchstart', function(e) {
    if (_forceRefreshing || window.scrollY > 0) { dragging = false; return; }
    startY = e.touches[0].clientY;
    dragging = true;
    pulling = false;
  }, { passive: true });

  document.addEventListener('touchmove', function(e) {
    if (!dragging) return;
    var dy = e.touches[0].clientY - startY;
    if (dy <= 0) { pulling = false; if (indicator) indicator.style.height = '0px'; return; }
    ensureIndicator();
    pulling = true;
    var h = Math.min(dy * 0.5, 90);
    indicator.style.height = h + 'px';
    if (h >= THRESHOLD) {
      iconEl.className = 'fas fa-rotate-right';
      textEl.textContent = 'Release to sync';
    } else {
      iconEl.className = 'fas fa-arrow-down';
      textEl.textContent = 'Pull to sync latest data';
    }
    if (dy > 8) e.preventDefault();
  }, { passive: false });

  document.addEventListener('touchend', function() {
    if (!dragging) return;
    dragging = false;
    if (!pulling || !indicator) return;
    var h = parseInt(indicator.style.height, 10) || 0;
    if (h >= THRESHOLD) {
      iconEl.className = 'fas fa-spinner fa-spin';
      textEl.textContent = 'Syncing…';
      indicator.style.height = '48px';
      forceRefreshSync();
    } else {
      indicator.style.height = '0px';
    }
    pulling = false;
  }, { passive: true });
})();
</script>
