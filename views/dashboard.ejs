<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main">
  <%- include('partials/header', {pageTitle: 'Dashboard'}) %>
  <div class="page">

    <!-- STAT CARDS -->
    <div class="stats-grid" style="grid-template-columns:repeat(3,1fr)">
      <a href="/shipments" style="text-decoration:none">
      <div class="stat-card success" style="cursor:pointer" title="Click to see day-wise shipments">
        <div class="stat-label">Sales Today <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;opacity:.6;margin-left:4px"></i></div>
        <div class="stat-value"><%- fmtShort(salesToday) %></div>
        <div class="stat-sub"><%- shipmentsToday %> shipment(s) today</div>
        <i class="fas fa-truck stat-icon"></i>
      </div>
      </a>
      <a href="/orders-status" style="text-decoration:none">
      <div class="stat-card" style="cursor:pointer" title="Click to see pending orders">
        <div class="stat-label">Pending Orders <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;opacity:.6;margin-left:4px"></i></div>
        <div class="stat-value"><%- pending %></div>
        <div class="stat-sub">
          <% if(pendingStates.length===0){ %>No pending orders
          <% } else { pendingStates.forEach(function(s,i){ %><%- s.name %>: <%- s.count %><%- i<pendingStates.length-1?' · ':'' %>
          <% }) } %>
        </div>
        <i class="fas fa-shopping-cart stat-icon"></i>
      </div>
      </a>
      <a href="/inventory" style="text-decoration:none">
      <div class="stat-card warn" title="Click to see stock alerts">
        <div class="stat-label">Stock Alerts <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;opacity:.6;margin-left:4px"></i></div>
        <div class="stat-value"><%- lowStock + outStock %></div>
        <div class="stat-sub"><%- outStock %> out · <%- lowStock %> low · <%- totalSKU %> total SKUs</div>
        <i class="fas fa-boxes-stacked stat-icon"></i>
      </div>
      </a>
    </div>

    <!-- ORDERS CHART – full width -->
    <div class="card" style="margin-bottom:20px">
      <div class="card-title" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <i class="fas fa-chart-column"></i>
        <span id="chartTitle">Monthly Orders</span>
        <span id="chartRangeLabel" style="font-size:11px;color:var(--text2);font-weight:400"></span>
        <div style="margin-left:auto;display:flex;gap:6px">
          <button id="btnMonthly" onclick="switchView('monthly')"
            style="padding:5px 14px;border-radius:7px;font-size:12px;cursor:pointer;font-weight:600;transition:all .15s;background:var(--accent);color:#fff;border:1px solid var(--accent)">
            <i class="fas fa-calendar-alt"></i> Monthly
          </button>
          <button id="btnDaily" onclick="switchView('daily')"
            style="padding:5px 14px;border-radius:7px;font-size:12px;cursor:pointer;font-weight:500;transition:all .15s;background:var(--bg3);color:var(--text2);border:1px solid var(--border)">
            <i class="fas fa-calendar-day"></i> Last 15 Days
          </button>
        </div>
      </div>
      <div id="chartData" data-monthly='<%- monthlyData %>' data-daily='<%- weeklyData %>' style="display:none"></div>
      <div class="chart-box" style="height:280px"><canvas id="weeklyChart"></canvas></div>
      <div id="showMoreWrap" style="text-align:center;margin-top:14px">
        <button id="showMoreBtn" onclick="loadMoreMonths()"
          style="background:var(--bg3);border:1px solid var(--border);color:var(--text2);padding:7px 22px;border-radius:7px;font-size:12px;cursor:pointer;transition:all .15s"
          onmouseover="this.style.color='var(--accent)';this.style.borderColor='var(--accent)'"
          onmouseout="this.style.color='var(--text2)';this.style.borderColor='var(--border)'">
          <i class="fas fa-chevron-left"></i> Show More (older months)
        </button>
      </div>
    </div>

    <!-- TABLES ROW -->
    <div class="grid-2">
      <div class="card">
        <div class="card-title"><i class="fas fa-trophy"></i> Top Products This Month</div>
        <% if(products.length===0){ %>
          <div class="empty"><i class="fas fa-box-open"></i>No sales data yet</div>
        <% } else { %>
        <ul class="top-list">
          <% products.forEach(function(p,i){ %>
          <li style="position:relative;transition:background .15s;border-radius:6px" onmouseover="this.style.background='rgba(108,99,255,.06)'" onmouseout="this.style.background=''">
            <% if(p.id){ %><a href="/product-analytics?id=<%- p.id %>&type=<%- p.type %>&name=<%- encodeURIComponent(p.name) %>" style="position:absolute;inset:0;z-index:1" title="View analytics for <%- p.name %>"></a><% } %>
            <span class="top-rank <%- i===0?'gold':'' %>"><%- i+1 %></span>
            <span class="name"><%- p.name %></span>
            <span class="sub">×<%- p.qty %></span>
            <span class="val"><%- fmtShort(p.val) %></span>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </div>
      <div class="card">
        <div class="card-title"><i class="fas fa-star"></i> Top Customers This Month</div>
        <% if(customers.length===0){ %>
          <div class="empty"><i class="fas fa-users"></i>No customer data yet</div>
        <% } else { %>
        <ul class="top-list">
          <% customers.forEach(function(c,i){ %>
          <li style="position:relative;transition:background .15s;border-radius:6px" onmouseover="this.style.background='rgba(108,99,255,.06)'" onmouseout="this.style.background=''">
            <% if(c.id){ %><a href="/customer-analytics?id=<%- c.id %>&name=<%- encodeURIComponent(c.name) %>" style="position:absolute;inset:0;z-index:1" title="View analytics for <%- c.name %>"></a><% } %>
            <span class="top-rank <%- i===0?'gold':'' %>"><%- i+1 %></span>
            <span class="name"><%- c.name %></span>
            <span class="sub"><%- c.orders %> orders</span>
            <span class="val"><%- fmtShort(c.val) %></span>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </div>
    </div>


  </div>
</div>
<%- include('partials/foot') %>

<script>
const COLORS = { accent:'#6c63ff', accent2:'#00d4aa', danger:'#ff4d6d', warn:'#ffa94d', text2:'#8891b5' };
Chart.defaults.color = COLORS.text2;
Chart.defaults.borderColor = 'rgba(108,99,255,.1)';

const _cd = document.getElementById('chartData');
const MONTHLY_INIT = JSON.parse(_cd.dataset.monthly);
const DAILY        = JSON.parse(_cd.dataset.daily);

let allMonths   = [...MONTHLY_INIT];
let currentView = 'monthly';
let noMoreData  = false;

// ── Growth % label plugin ─────────────────────────────────
const growthPlugin = {
  id: 'growthLabels',
  afterDatasetsDraw(chart) {
    if (currentView !== 'monthly') return;
    const { ctx } = chart;
    const meta   = chart.getDatasetMeta(0);
    const counts = chart.data.datasets[0].data;
    meta.data.forEach((bar, i) => {
      const curr = counts[i];
      // Draw order count inside/below top of bar
      ctx.save();
      ctx.fillStyle = 'rgba(255,255,255,.75)';
      ctx.font = '600 11px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      ctx.fillText(curr, bar.x, bar.y + 5);
      ctx.restore();

      // Newest is on the left; older month is at i+1 (to the right)
      const prev = counts[i + 1];
      if (prev == null) return; // last bar = oldest, no prior month to compare
      const pct   = prev === 0 ? null : ((curr - prev) / prev * 100);
      const text  = pct === null ? 'NEW' : (pct >= 0 ? '▲' : '▼') + ' ' + Math.abs(pct).toFixed(0) + '%';
      const color = pct === null ? COLORS.accent : pct >= 0 ? COLORS.accent2 : COLORS.danger;

      // Pill background
      ctx.save();
      ctx.font = 'bold 10px Inter, sans-serif';
      const tw = ctx.measureText(text).width + 10;
      const px = bar.x - tw / 2, py = bar.y - 24;
      ctx.fillStyle = pct === null ? 'rgba(108,99,255,.2)' : pct >= 0 ? 'rgba(0,212,170,.18)' : 'rgba(255,77,109,.18)';
      roundRect(ctx, px, py, tw, 16, 4);
      ctx.fill();
      ctx.fillStyle = color;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, bar.x, py + 8);
      ctx.restore();
    });
  }
};

function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

// ── Chart init ────────────────────────────────────────────
const weeklyChart = new Chart(document.getElementById('weeklyChart'), {
  type: 'bar',
  plugins: [growthPlugin],
  data: { labels: [], datasets: [{ label: 'Orders', data: [],
    backgroundColor: 'rgba(108,99,255,.65)', borderColor: COLORS.accent,
    borderWidth: 1, borderRadius: 6 }] },
  options: {
    responsive: true, maintainAspectRatio: false,
    layout: { padding: { top: 32, left: 4, right: 4 } },
    plugins: {
      legend: { display: false },
      tooltip: {
        callbacks: {
          title: i => i[0].label,
          label: c => {
            const idx  = c.dataIndex;
            const curr = c.raw;
            const prev = c.dataset.data[idx + 1]; // older month is to the right
            if (prev == null) return `${curr} orders`;
            const pct = prev === 0 ? '∞' : ((curr - prev) / prev * 100).toFixed(1) + '%';
            const sign = (prev === 0 || curr >= prev) ? '+' : '';
            return [`${curr} orders`, `Growth vs prev month: ${sign}${pct}`];
          }
        }
      }
    },
    scales: {
      y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: 'rgba(108,99,255,.07)' } },
      x: { grid: { display: false } }
    }
  }
});

// ── Render helpers ────────────────────────────────────────
function renderMonthly() {
  // Newest month on the LEFT — reverse allMonths (which is oldest→newest)
  const display = [...allMonths].reverse();
  weeklyChart.data.labels             = display.map(m => m.label);
  weeklyChart.data.datasets[0].data  = display.map(m => m.count);
  weeklyChart.update();
  const newest = allMonths[allMonths.length - 1]?.label || '';
  const oldest = allMonths[0]?.label || '';
  document.getElementById('chartTitle').textContent      = 'Monthly Orders';
  document.getElementById('chartRangeLabel').textContent = newest && oldest ? `${newest} → ${oldest}` : '';
  document.getElementById('showMoreWrap').style.display  = 'block';
}

function makeDayLabel(daysAgo) {
  const d = new Date(); d.setDate(d.getDate() - daysAgo);
  return d.toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short' });
}

function renderDaily() {
  const reversed = [...DAILY].reverse();
  const offset   = DAILY.length - 1;
  weeklyChart.data.labels             = reversed.map((_, i) => makeDayLabel(offset - i));
  weeklyChart.data.datasets[0].data  = reversed;
  weeklyChart.update();
  document.getElementById('chartTitle').textContent      = 'Orders — Last 15 Days';
  document.getElementById('chartRangeLabel').textContent = `${makeDayLabel(offset)} → ${makeDayLabel(0)}`;
  document.getElementById('showMoreWrap').style.display  = 'none';
}

// ── Show More (prepend older months) ─────────────────────
let loadingMore = false;
async function loadMoreMonths() {
  if (loadingMore || noMoreData) return;
  loadingMore = true;
  const btn = document.getElementById('showMoreBtn');
  const orig = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';
  btn.disabled  = true;
  try {
    const before = allMonths[0]?.key || '2025-12';
    const resp   = await fetch(`/api/orders/monthly?before=${before}`);
    const older  = await resp.json();
    if (!older.length) {
      noMoreData    = true;
      btn.innerHTML = '<i class="fas fa-check"></i> All data loaded';
      return;
    }
    allMonths = [...older, ...allMonths];
    renderMonthly();
    if (older.every(m => m.count === 0)) {
      noMoreData    = true;
      btn.innerHTML = '<i class="fas fa-check"></i> All data loaded';
      return;
    }
    btn.innerHTML = orig;
    btn.disabled  = false;
  } catch(e) {
    btn.innerHTML = orig;
    btn.disabled  = false;
  }
  loadingMore = false;
}

// ── Toggle buttons ────────────────────────────────────────
const ACTIVE_STYLE   = 'padding:5px 14px;border-radius:7px;font-size:12px;cursor:pointer;font-weight:600;transition:all .15s;background:var(--accent);color:#fff;border:1px solid var(--accent)';
const INACTIVE_STYLE = 'padding:5px 14px;border-radius:7px;font-size:12px;cursor:pointer;font-weight:500;transition:all .15s;background:var(--bg3);color:var(--text2);border:1px solid var(--border)';

function switchView(view) {
  currentView = view;
  document.getElementById('btnMonthly').style.cssText = view === 'monthly' ? ACTIVE_STYLE : INACTIVE_STYLE;
  document.getElementById('btnDaily').style.cssText   = view === 'daily'   ? ACTIVE_STYLE : INACTIVE_STYLE;
  view === 'monthly' ? renderMonthly() : renderDaily();
}

// Default
renderMonthly();
</script>
