<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main">
  <%- include('partials/header', {pageTitle: 'Dashboard'}) %>
  <div class="page">

    <!-- STAT CARDS -->
    <div class="stats-grid" style="grid-template-columns:repeat(3,1fr)">
      <a href="/shipments" style="text-decoration:none">
      <div class="stat-card success" style="cursor:pointer" title="Click to see day-wise shipments">
        <div class="stat-label">Sales Today <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;opacity:.6;margin-left:4px"></i></div>
        <div class="stat-value"><%- fmtShort(salesToday) %></div>
        <div class="stat-sub"><%- shipmentsToday %> shipment(s) today<% if(typeof todayPCS !== 'undefined' && todayPCS > 0){ %> · <strong><%- todayPCS.toLocaleString('en-US') %> pcs</strong><% } %></div>
        <i class="fas fa-truck stat-icon"></i>
      </div>
      </a>
      <a href="/orders-status" style="text-decoration:none">
      <div class="stat-card" style="cursor:pointer" title="Click to see pending orders">
        <div class="stat-label">Pending Orders <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;opacity:.6;margin-left:4px"></i></div>
        <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
          <div class="stat-value"><%- pending %></div>
          <div style="font-size:18px;font-weight:700;color:var(--accent);letter-spacing:-.3px;padding:2px 10px;background:rgba(108,99,255,.11);border-radius:7px;white-space:nowrap"><%- fmtShort(pendingValue) %></div>
        </div>
        <div class="stat-sub" style="margin-top:4px">
          <% if(typeof pendingPCS !== 'undefined' && pendingPCS > 0){ %><strong><%- pendingPCS.toLocaleString('en-US') %> pcs</strong> · <% } %>
          <% if(pendingStates.length===0 && !(draftCount > 0)){ %>No pending orders
          <% } else { pendingStates.forEach(function(s,i){ %><%- s.name %>: <%- s.count %><%- (i<pendingStates.length-1 || draftCount>0)?' · ':'' %><% }); if(draftCount > 0){ %>Draft: <%- draftCount %><% } } %>
        </div>
        <i class="fas fa-shopping-cart stat-icon"></i>
      </div>
      </a>
      <a href="/inventory" style="text-decoration:none">
      <div class="stat-card warn" title="Click to see stock alerts">
        <div class="stat-label">Stock Alerts <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;opacity:.6;margin-left:4px"></i></div>
        <div class="stat-value"><%- lowStock + outStock %></div>
        <div class="stat-sub"><%- outStock %> out · <%- lowStock %> low · <%- totalSKU %> total SKUs</div>
        <i class="fas fa-boxes-stacked stat-icon"></i>
      </div>
      </a>
    </div>

    <!-- ORDERS CHART – full width -->
    <div class="card" style="margin-bottom:20px">
      <div class="card-title" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <i class="fas fa-chart-column"></i>
        <span id="chartTitle">Monthly Revenue</span>
        <span id="chartRangeLabel" style="font-size:11px;color:var(--text2);font-weight:400"></span>
        <div style="margin-left:auto;display:flex;gap:6px;align-items:center">
          <button id="btnMonthly" onclick="switchView('monthly')"
            style="padding:5px 14px;border-radius:7px;font-size:12px;cursor:pointer;font-weight:600;transition:all .15s;background:var(--accent);color:#fff;border:1px solid var(--accent)">
            <i class="fas fa-calendar-alt"></i> Monthly
          </button>
          <button id="btnDaily" onclick="switchView('daily')"
            style="padding:5px 14px;border-radius:7px;font-size:12px;cursor:pointer;font-weight:500;transition:all .15s;background:var(--bg3);color:var(--text2);border:1px solid var(--border)">
            <i class="fas fa-calendar-day"></i> Last 15 Days
          </button>
        </div>
      </div>
      <div id="chartData" data-monthly='<%- monthlyData %>' data-daily='<%- weeklyData %>' style="display:none"></div>
      <div class="chart-box" style="height:280px"><canvas id="weeklyChart"></canvas></div>
      <div id="showMoreWrap" style="text-align:center;margin-top:14px">
        <button id="showMoreBtn" onclick="loadMoreMonths()"
          style="background:var(--bg3);border:1px solid var(--border);color:var(--text2);padding:7px 22px;border-radius:7px;font-size:12px;cursor:pointer;transition:all .15s"
          onmouseover="this.style.color='var(--accent)';this.style.borderColor='var(--accent)'"
          onmouseout="this.style.color='var(--text2)';this.style.borderColor='var(--border)'">
          <i class="fas fa-chevron-left"></i> Show More (older months)
        </button>
      </div>
      <div style="display:flex;gap:12px;justify-content:center;margin-top:18px;padding-top:16px;border-top:1px solid var(--border)">
        <a href="/sku-analysis" style="text-decoration:none">
          <button style="display:flex;align-items:center;gap:9px;padding:10px 26px;border-radius:9px;border:1.5px solid var(--accent);background:rgba(108,99,255,.13);color:var(--accent);font-size:13px;font-weight:700;cursor:pointer;transition:all .18s;box-shadow:0 2px 10px rgba(108,99,255,.13)"
            onmouseover="this.style.background='var(--accent)';this.style.color='#fff';this.style.boxShadow='0 4px 16px rgba(108,99,255,.35)'"
            onmouseout="this.style.background='rgba(108,99,255,.13)';this.style.color='var(--accent)';this.style.boxShadow='0 2px 10px rgba(108,99,255,.13)'">
            <i class="fas fa-barcode" style="font-size:14px"></i> SKU Analysis
          </button>
        </a>
        <a href="/salesman" style="text-decoration:none">
          <button style="display:flex;align-items:center;gap:9px;padding:10px 26px;border-radius:9px;border:1.5px solid var(--accent);background:rgba(108,99,255,.13);color:var(--accent);font-size:13px;font-weight:700;cursor:pointer;transition:all .18s;box-shadow:0 2px 10px rgba(108,99,255,.13)"
            onmouseover="this.style.background='var(--accent)';this.style.color='#fff';this.style.boxShadow='0 4px 16px rgba(108,99,255,.35)'"
            onmouseout="this.style.background='rgba(108,99,255,.13)';this.style.color='var(--accent)';this.style.boxShadow='0 2px 10px rgba(108,99,255,.35)'">
            <i class="fas fa-user-tie" style="font-size:14px"></i> Salesman Analysis
          </button>
        </a>
      </div>
    </div>

    <!-- TABLES ROW -->
    <div class="grid-2">
      <div class="card">
        <div class="card-title"><i class="fas fa-trophy"></i> Top Products This Month</div>
        <% if(products.length===0){ %>
          <div class="empty"><i class="fas fa-box-open"></i>No sales data yet</div>
        <% } else { %>
        <ul class="top-list">
          <% products.forEach(function(p,i){ %>
          <li style="position:relative;transition:background .15s;border-radius:6px" onmouseover="this.style.background='rgba(108,99,255,.06)'" onmouseout="this.style.background=''">
            <% if(p.id){ %><a href="/product-analytics?id=<%- p.id %>&type=<%- p.type %>&name=<%- encodeURIComponent(p.name) %>" style="position:absolute;inset:0;z-index:1" title="View analytics for <%- p.name %>"></a><% } %>
            <span class="top-rank <%- i===0?'gold':'' %>"><%- i+1 %></span>
            <span class="name"><%- p.name %></span>
            <span class="sub">×<%- p.qty %></span>
            <span class="val"><%- fmtShort(p.val) %></span>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </div>
      <div class="card">
        <div class="card-title"><i class="fas fa-star"></i> Top Customers This Month</div>
        <% if(customers.length===0){ %>
          <div class="empty"><i class="fas fa-users"></i>No customer data yet</div>
        <% } else { %>
        <ul class="top-list">
          <% customers.forEach(function(c,i){ %>
          <li style="position:relative;transition:background .15s;border-radius:6px" onmouseover="this.style.background='rgba(108,99,255,.06)'" onmouseout="this.style.background=''">
            <% if(c.id){ %><a href="/customer-analytics?id=<%- c.id %>&name=<%- encodeURIComponent(c.name) %>" style="position:absolute;inset:0;z-index:1" title="View analytics for <%- c.name %>"></a><% } %>
            <span class="top-rank <%- i===0?'gold':'' %>"><%- i+1 %></span>
            <span class="name"><%- c.name %></span>
            <span class="sub"><%- c.orders %> orders</span>
            <span class="val"><%- fmtShort(c.val) %></span>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </div>
    </div>


  </div>
</div>
<%- include('partials/foot') %>

<script>
// Server-injected constants for pro-rata growth comparison
const PREV_MONTH_PRO_RATA = <%- prevMonthProRata %>;  // prev month revenue up to same day
const DAY_OF_MONTH        = <%- dayOfMonth %>;         // today's day-of-month (e.g. 21)

const COLORS = { accent:'#6c63ff', accent2:'#00d4aa', danger:'#ff4d6d', warn:'#ffa94d', text2:'#8891b5' };
Chart.defaults.color = COLORS.text2;
Chart.defaults.borderColor = 'rgba(108,99,255,.1)';

const _cd = document.getElementById('chartData');
const MONTHLY_INIT = JSON.parse(_cd.dataset.monthly);
const DAILY        = JSON.parse(_cd.dataset.daily);

let allMonths   = [...MONTHLY_INIT];
let currentView = 'monthly';
let noMoreData  = false;

function fmtTick(v) {
  if (v >= 1e9) return '₽' + (v/1e9).toFixed(1) + 'B';
  if (v >= 1e6) return '₽' + (v/1e6).toFixed(1) + 'M';
  if (v >= 1e3) return '₽' + Math.round(v/1e3) + 'K';
  return '₽' + Math.round(v);
}
function fmtFull(v) {
  if (v >= 1e9) return '₽' + (v/1e9).toFixed(2) + 'B';
  if (v >= 1e6) return '₽' + (v/1e6).toFixed(2) + 'M';
  if (v >= 1e3) return '₽' + Math.round(v/1e3) + 'K';
  return '₽' + Math.round(v);
}

// ── Growth % + value label plugin ────────────────────────
const growthPlugin = {
  id: 'growthLabels',
  afterDatasetsDraw(chart) {
    if (currentView !== 'monthly') return;
    const { ctx } = chart;
    const barMeta = chart.getDatasetMeta(0);
    const barVals = chart.data.datasets[0].data;
    barMeta.data.forEach((bar, i) => {
      const curr = barVals[i];
      // Value label inside bar top
      ctx.save();
      ctx.fillStyle = 'rgba(255,255,255,.82)';
      ctx.font = '600 10px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      ctx.fillText(fmtTick(curr), bar.x, bar.y + 5);
      ctx.restore();
      // Growth % pill vs previous month (older is to the right).
      // For the current (leftmost, i=0) bar: compare against pro-rata of prev month
      // (same number of days elapsed) so an incomplete month never shows fake -ve growth.
      const prev = (i === 0 && allMonths.length > 1) ? PREV_MONTH_PRO_RATA : barVals[i + 1];
      if (prev == null) return;
      const pct   = prev === 0 ? null : ((curr - prev) / prev * 100);
      const text  = pct === null ? 'NEW' : (pct >= 0 ? '▲' : '▼') + ' ' + Math.abs(pct).toFixed(0) + '%';
      const color = pct === null ? COLORS.accent : pct >= 0 ? COLORS.accent2 : COLORS.danger;
      ctx.save();
      ctx.font = 'bold 10px Inter, sans-serif';
      const tw = ctx.measureText(text).width + 10;
      const px = bar.x - tw / 2, py = bar.y - 24;
      ctx.fillStyle = pct === null ? 'rgba(108,99,255,.2)' : pct >= 0 ? 'rgba(0,212,170,.18)' : 'rgba(255,77,109,.18)';
      roundRect(ctx, px, py, tw, 16, 4);
      ctx.fill();
      ctx.fillStyle = color;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, bar.x, py + 8);
      ctx.restore();
    });
  }
};

function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y); ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

// ── Chart init (bar + line combo) ────────────────────────
const weeklyChart = new Chart(document.getElementById('weeklyChart'), {
  type: 'bar',
  plugins: [growthPlugin],
  data: {
    labels: [],
    datasets: [
      { // 0 – bar (primary metric)
        type: 'bar', label: 'Revenue', data: [],
        backgroundColor: 'rgba(108,99,255,.65)', borderColor: COLORS.accent,
        borderWidth: 1, borderRadius: 6, yAxisID: 'yBar', order: 2
      },
      { // 1 – line (secondary metric)
        type: 'line', label: 'Shipments', data: [],
        borderColor: COLORS.accent2, backgroundColor: 'rgba(0,212,170,.12)',
        borderWidth: 2.5, pointRadius: 4, pointBackgroundColor: COLORS.accent2,
        fill: false, tension: 0.35, yAxisID: 'yLine', order: 1
      }
    ]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    layout: { padding: { top: 36, left: 4, right: 8 } },
    plugins: {
      legend: { display: false },
      tooltip: {
        callbacks: {
          title: i => i[0].label,
          label: c => {
            const idx = c.dataIndex;
            if (c.datasetIndex === 0) {
              const curr = c.raw;
              // Current month (idx=0): use pro-rata so comparison is day-for-day fair
              const isCurrentMonth = idx === 0 && allMonths.length > 1;
              const prev = isCurrentMonth ? PREV_MONTH_PRO_RATA : c.dataset.data[idx + 1];
              if (prev == null) return `Revenue: ${fmtFull(curr)}`;
              const pct  = prev === 0 ? '∞' : ((curr - prev) / prev * 100).toFixed(1) + '%';
              const sign = (prev === 0 || curr >= prev) ? '+' : '';
              const growthLabel = isCurrentMonth
                ? `Growth vs prev ${DAY_OF_MONTH}d: ${sign}${pct}`
                : `Growth vs prev: ${sign}${pct}`;
              return [`Revenue: ${fmtFull(curr)}`, growthLabel];
            }
            return `Shipments: ${c.raw}`;
          }
        }
      }
    },
    scales: {
      yBar: {
        type: 'linear', position: 'left', beginAtZero: true,
        ticks: { callback: v => fmtTick(v) },
        grid: { color: 'rgba(108,99,255,.07)' }
      },
      yLine: {
        type: 'linear', position: 'right', beginAtZero: true,
        ticks: { callback: v => Number.isInteger(v) ? v : '' },
        grid: { display: false }
      },
      x: { grid: { display: false } }
    }
  }
});

// ── Data helpers ──────────────────────────────────────────
const barOf  = m => m.value;
const lineOf = m => m.count;

function renderMonthly() {
  const display = [...allMonths].reverse();
  weeklyChart.data.labels = display.map(m => m.label);
  weeklyChart.data.datasets[0].data = display.map(barOf);
  weeklyChart.data.datasets[1].data = display.map(lineOf);
  weeklyChart.update();
  const newest = allMonths[allMonths.length - 1]?.label || '';
  const oldest = allMonths[0]?.label || '';
  document.getElementById('chartTitle').textContent      = 'Monthly Revenue';
  document.getElementById('chartRangeLabel').textContent = newest && oldest ? `${newest} → ${oldest}` : '';
  document.getElementById('showMoreWrap').style.display  = 'block';
}

function makeDayLabel(daysAgo) {
  const d = new Date(); d.setDate(d.getDate() - daysAgo);
  return d.toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short' });
}

function renderDaily() {
  const reversed = [...DAILY].reverse();
  const offset   = DAILY.length - 1;
  weeklyChart.data.labels = reversed.map((_, i) => makeDayLabel(offset - i));
  weeklyChart.data.datasets[0].data = reversed.map(barOf);
  weeklyChart.data.datasets[1].data = reversed.map(lineOf);
  weeklyChart.update();
  document.getElementById('chartTitle').textContent      = 'Revenue — Last 15 Days';
  document.getElementById('chartRangeLabel').textContent = `${makeDayLabel(offset)} → ${makeDayLabel(0)}`;
  document.getElementById('showMoreWrap').style.display  = 'none';
}

function render() { currentView === 'monthly' ? renderMonthly() : renderDaily(); }

// ── Show More ─────────────────────────────────────────────
let loadingMore = false;
async function loadMoreMonths() {
  if (loadingMore || noMoreData) return;
  loadingMore = true;
  const btn = document.getElementById('showMoreBtn');
  const orig = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';
  btn.disabled  = true;
  try {
    const before = allMonths[0]?.key || '2025-12';
    const resp   = await fetch(`/api/orders/monthly?before=${before}`);
    const older  = await resp.json();
    if (!older.length) { noMoreData = true; btn.innerHTML = '<i class="fas fa-check"></i> All data loaded'; return; }
    allMonths = [...older, ...allMonths];
    renderMonthly();
    if (older.every(m => m.count === 0 && m.value === 0)) { noMoreData = true; btn.innerHTML = '<i class="fas fa-check"></i> All data loaded'; return; }
    btn.innerHTML = orig; btn.disabled = false;
  } catch(e) { btn.innerHTML = orig; btn.disabled = false; }
  loadingMore = false;
}

// ── Toggle buttons ────────────────────────────────────────
const ST_ACTIVE  = 'padding:5px 14px;border-radius:7px;font-size:12px;cursor:pointer;font-weight:600;transition:all .15s;background:var(--accent);color:#fff;border:1px solid var(--accent)';
const ST_INACTIVE= 'padding:5px 14px;border-radius:7px;font-size:12px;cursor:pointer;font-weight:500;transition:all .15s;background:var(--bg3);color:var(--text2);border:1px solid var(--border)';

function switchView(view) {
  currentView = view;
  document.getElementById('btnMonthly').style.cssText = view === 'monthly' ? ST_ACTIVE : ST_INACTIVE;
  document.getElementById('btnDaily').style.cssText   = view === 'daily'   ? ST_ACTIVE : ST_INACTIVE;
  render();
}

// Init
switchView('monthly');
</script>
