<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main">
  <%- include('partials/header', {pageTitle: 'SKU Analysis'}) %>
  <div class="page">

    <!-- Stat Cards -->
    <div class="stats-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:20px">
      <div class="stat-card">
        <div class="stat-label">Shipments</div>
        <div class="stat-value"><%- shipmentCount %></div>
        <div class="stat-sub">actual dispatches</div>
        <i class="fas fa-truck stat-icon"></i>
      </div>
      <div class="stat-card success">
        <div class="stat-label">Total PCS Sold</div>
        <div class="stat-value"><%- totalPCS.toLocaleString('en-IN') %></div>
        <div class="stat-sub">units from shipments</div>
        <i class="fas fa-box-open stat-icon"></i>
      </div>
      <div class="stat-card">
        <div class="stat-label">Models</div>
        <div class="stat-value"><%- totalModels %></div>
        <div class="stat-sub">product lines</div>
        <i class="fas fa-layer-group stat-icon"></i>
      </div>
      <div class="stat-card warn">
        <div class="stat-label">Active SKUs</div>
        <div class="stat-value"><%- totalSKUs %></div>
        <div class="stat-sub">flavours sold</div>
        <i class="fas fa-tags stat-icon"></i>
      </div>
    </div>

    <!-- Period filter -->
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:10px 16px;flex-wrap:wrap">
      <i class="fas fa-calendar-alt" style="color:var(--text2);font-size:13px"></i>
      <label style="font-size:13px;color:var(--text2)">Period:</label>
      <select id="periodSel" onchange="window.location.href='/sku-analysis?period='+this.value"
        style="background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:6px 14px;border-radius:8px;font-size:13px;outline:none;cursor:pointer">
        <% months.forEach(function(m){ %>
        <option value="<%- m.key %>" <%- period===m.key?'selected':'' %>><%- m.label %></option>
        <% }) %>
      </select>
      <div style="margin-left:auto;display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text2)">
        <i class="fas fa-circle-check" style="color:#00d4aa"></i>
        Data from actual shipments only
      </div>
    </div>

    <% if(totalSKUs === 0) { %>
    <div class="card" style="text-align:center;padding:60px 20px">
      <i class="fas fa-truck" style="font-size:40px;color:var(--text2);margin-bottom:16px;display:block"></i>
      <div style="font-size:16px;font-weight:600;color:var(--text);margin-bottom:6px">No shipments found</div>
      <div style="font-size:13px;color:var(--text2)">No dispatched shipments for this period</div>
    </div>
    <% } else { %>

    <!-- ═══════════════════════════════════════════════════════
         SECTION 1 — PCS per Model (chart + table)
    ════════════════════════════════════════════════════════ -->
    <div class="card" style="margin-bottom:20px">
      <div class="card-title"><i class="fas fa-layer-group"></i> Total PCS Sold — By Model</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start">
        <div style="height:<%- Math.max(160, Math.min(models.length * 44, 460)) %>px;position:relative">
          <canvas id="modelChart"></canvas>
        </div>
        <div class="table-wrap" style="max-height:460px;overflow-y:auto">
          <table>
            <thead>
              <tr>
                <th style="width:28px">#</th>
                <th>Model</th>
                <th style="text-align:right">PCS Sold</th>
                <th style="text-align:right">Share</th>
                <th style="text-align:right">SKUs</th>
              </tr>
            </thead>
            <tbody>
              <% models.forEach(function(m, i) { %>
              <tr>
                <td style="color:var(--text2);font-size:12px"><%- i+1 %></td>
                <td style="font-weight:600;font-size:13px"><%- m.name %></td>
                <td style="text-align:right;font-weight:700;font-size:14px;color:var(--accent2)">
                  <%- m.totalPCS.toLocaleString('en-IN') %>
                </td>
                <td style="text-align:right">
                  <div style="display:flex;align-items:center;justify-content:flex-end;gap:8px">
                    <div style="width:54px;height:5px;background:var(--bg3);border-radius:3px">
                      <div style="height:5px;border-radius:3px;background:var(--accent);width:<%- totalPCS>0?Math.round(m.totalPCS/totalPCS*100):0 %>%"></div>
                    </div>
                    <span style="font-size:12px;color:var(--text2);min-width:36px;text-align:right"><%- totalPCS>0?((m.totalPCS/totalPCS)*100).toFixed(1):0 %>%</span>
                  </div>
                </td>
                <td style="text-align:right;font-size:12px;color:var(--text2)"><%- m.skus.length %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         SECTION 2 — Top Selling & Low Selling (rank rows)
    ════════════════════════════════════════════════════════ -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px">

      <!-- TOP SELLING -->
      <div class="card">
        <div class="card-title" style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
          <i class="fas fa-trophy" style="color:#ffd700"></i> Top Selling Flavours
          <span style="margin-left:auto;font-size:11px;color:var(--text2);font-weight:400">by pcs shipped</span>
        </div>
        <% var maxTop = topSKUs.length > 0 ? topSKUs[0].pcs : 1; %>
        <% topSKUs.forEach(function(s, i) {
          var borderClr = i===0?'#ffd700':i===1?'#a0aec0':i===2?'#c87941':'var(--border)';
          var numClr    = i===0?'#ffd700':i===1?'#a0aec0':i===2?'#c87941':'var(--accent2)';
          var bgStyle   = i===0?'rgba(255,215,0,.07)':i===1?'rgba(192,192,192,.05)':i===2?'rgba(200,121,65,.05)':'';
          var barClr    = i===0?'#ffd700':i===1?'#a0aec0':i===2?'#c87941':'var(--accent)';
          var barW      = Math.round(s.pcs/maxTop*100);
        %>
        <div style="display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:10px;margin-bottom:5px;border-left:3px solid <%- borderClr %>;background:<%- bgStyle %>">
          <% if(i===0){%><span style="font-size:15px;flex-shrink:0">🥇</span>
          <%}else if(i===1){%><span style="font-size:15px;flex-shrink:0">🥈</span>
          <%}else if(i===2){%><span style="font-size:15px;flex-shrink:0">🥉</span>
          <%}else{%><span style="font-size:11px;color:var(--text2);width:20px;text-align:center;flex-shrink:0"><%- i+1 %></span><%}%>
          <div style="flex:1;min-width:0">
            <div style="font-weight:700;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text)"><%- s.sku %></div>
            <div style="font-size:10px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:4px"><%- s.model %></div>
            <div style="height:3px;background:var(--bg3);border-radius:2px">
              <div style="height:3px;border-radius:2px;background:<%- barClr %>;width:<%- barW %>%;transition:width .3s"></div>
            </div>
          </div>
          <div style="text-align:right;flex-shrink:0">
            <div style="font-size:15px;font-weight:800;color:<%- numClr %>"><%- s.pcs.toLocaleString('en-IN') %></div>
            <div style="font-size:9px;color:var(--text2)">pcs</div>
          </div>
        </div>
        <% }) %>
      </div>

      <!-- LOW SELLING -->
      <div class="card">
        <div class="card-title" style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
          <i class="fas fa-arrow-trend-down" style="color:#ff6b6b"></i> Low Selling SKUs
          <span style="margin-left:auto;font-size:11px;color:var(--text2);font-weight:400">slowest movers</span>
        </div>
        <% var maxLow = lowSKUs.length > 0 ? lowSKUs[lowSKUs.length-1].pcs : 1; %>
        <% lowSKUs.forEach(function(s, i) {
          var alpha  = i===0?'rgba(255,107,107,.1)':i===1?'rgba(255,169,77,.06)':'';
          var clrL   = i===0?'#ff6b6b':i===1?'#ffa94d':'var(--border)';
          var numClr = i===0?'#ff6b6b':i===1?'#ffa94d':'#ff8787';
          var barClr = i===0?'#ff6b6b':i===1?'#ffa94d':'rgba(255,107,107,.5)';
          var barW   = maxLow > 0 ? Math.round(s.pcs/maxLow*100) : 0;
        %>
        <div style="display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:10px;margin-bottom:5px;border-left:3px solid <%- clrL %>;background:<%- alpha %>">
          <% if(i===0){%><i class="fas fa-circle-exclamation" style="color:#ff6b6b;font-size:13px;flex-shrink:0"></i>
          <%}else if(i===1){%><i class="fas fa-triangle-exclamation" style="color:#ffa94d;font-size:13px;flex-shrink:0"></i>
          <%}else{%><span style="font-size:11px;color:var(--text2);width:20px;text-align:center;flex-shrink:0"><%- i+1 %></span><%}%>
          <div style="flex:1;min-width:0">
            <div style="font-weight:700;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text)"><%- s.sku %></div>
            <div style="font-size:10px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:4px"><%- s.model %></div>
            <div style="height:3px;background:var(--bg3);border-radius:2px">
              <div style="height:3px;border-radius:2px;background:<%- barClr %>;width:<%- barW %>%;transition:width .3s"></div>
            </div>
          </div>
          <div style="text-align:right;flex-shrink:0">
            <div style="font-size:15px;font-weight:800;color:<%- numClr %>"><%- s.pcs.toLocaleString('en-IN') %></div>
            <div style="font-size:9px;color:var(--text2)">pcs</div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         SECTION 3 — Model Deep-Dive: tabs + pie + flavour list
    ════════════════════════════════════════════════════════ -->
    <div class="card">
      <div class="card-title" style="margin-bottom:16px">
        <i class="fas fa-chart-pie"></i> Flavour-wise Breakdown — by Model
      </div>

      <!-- Model Tab Pills -->
      <div id="modelTabs" style="display:flex;gap:8px;flex-wrap:wrap;padding-bottom:16px;margin-bottom:20px;border-bottom:1px solid var(--border)"></div>

      <!-- Pie chart (left) + Flavour table (right) -->
      <div style="display:grid;grid-template-columns:360px 1fr;gap:28px;align-items:start">

        <!-- Donut chart -->
        <div style="position:sticky;top:20px">
          <div style="position:relative;height:320px"><canvas id="skuPie"></canvas></div>
          <!-- Summary stats under chart -->
          <div id="pieStats" style="display:flex;gap:0;margin-top:16px;border:1px solid var(--border);border-radius:10px;overflow:hidden"></div>
        </div>

        <!-- Flavour table -->
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px">
            <div>
              <div id="deepModelName" style="font-size:15px;font-weight:700;color:var(--text)"></div>
              <div id="deepModelSub"  style="font-size:12px;color:var(--text2);margin-top:2px"></div>
            </div>
            <div style="position:relative">
              <i class="fas fa-search" style="position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:10px;color:var(--text2);pointer-events:none"></i>
              <input id="flavourSearch" type="text" placeholder="Search flavour…" oninput="filterFlavours(this.value)"
                style="padding:6px 10px 6px 28px;font-size:12px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;color:var(--text);outline:none;width:200px">
            </div>
          </div>
          <div class="table-wrap" style="max-height:400px;overflow-y:auto">
            <table>
              <thead>
                <tr>
                  <th style="width:28px">#</th>
                  <th style="width:12px"></th>
                  <th>Flavour / SKU</th>
                  <th style="text-align:right">PCS Sold</th>
                  <th style="text-align:right;min-width:120px">Share of Model</th>
                </tr>
              </thead>
              <tbody id="flavourBody"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <% } %>
  </div>
</div>

<script type="application/json" id="modelsData"><%- modelsJSON %></script>

<script>
const MODELS    = JSON.parse(document.getElementById('modelsData').textContent);
const TOTAL_PCS = <%- totalPCS %>;

const PALETTE = [
  '#6c63ff','#00d4aa','#ffa94d','#ff6b9d','#4dabf7','#94d82d','#f06595','#74c0fc',
  '#ffd43b','#63e6be','#e599f7','#ff8787','#66d9e8','#cc5de8','#ff6b6b','#a9e34b',
  '#748ffc','#38d9a9','#fd7e14','#e64980','#20c997','#4263eb'
];
const TEXT2 = '#8891b5';

Chart.defaults.color       = TEXT2;
Chart.defaults.borderColor = 'rgba(108,99,255,.1)';

// ── Center-text plugin for doughnut ──────────────────────
Chart.register({
  id: 'doughnutCenter',
  afterDraw(chart) {
    if (chart.config.type !== 'doughnut') return;
    const { ctx, chartArea } = chart;
    if (!chartArea) return;
    const cx = (chartArea.left + chartArea.right) / 2;
    const cy = (chartArea.top  + chartArea.bottom) / 2;
    const total = chart.data.datasets[0].data.reduce((a, v) => a + (v||0), 0);
    ctx.save();
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.font = 'bold 26px Inter,system-ui,sans-serif';
    ctx.fillStyle = '#e0e1f0';
    ctx.fillText(total.toLocaleString('en-IN'), cx, cy - 13);
    ctx.font = '12px Inter,system-ui,sans-serif';
    ctx.fillStyle = TEXT2;
    ctx.fillText('total pcs', cx, cy + 12);
    ctx.restore();
  }
});

// ── Model bar chart (Section 1) ───────────────────────────
(function() {
  const ctx = document.getElementById('modelChart');
  if (!ctx || !MODELS.length) return;
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: MODELS.map(m => m.name.length > 22 ? m.name.slice(0,22)+'…' : m.name),
      datasets: [{ label: 'PCS Sold', data: MODELS.map(m => m.totalPCS),
        backgroundColor: PALETTE.slice(0, MODELS.length), borderWidth:0, borderRadius:6, barThickness:28 }]
    },
    options: {
      indexAxis:'y', responsive:true, maintainAspectRatio:false,
      plugins: { legend:{display:false}, tooltip:{callbacks:{label:c=>' '+c.raw.toLocaleString('en-IN')+' pcs'}} },
      scales: {
        x:{ beginAtZero:true, ticks:{callback:v=>v>=1000?(v/1000).toFixed(0)+'K':v}, grid:{color:'rgba(108,99,255,.07)'} },
        y:{ grid:{display:false}, ticks:{font:{size:11}} }
      }
    }
  });
})();

// ── Model Deep-Dive (Section 3) ───────────────────────────
let pieChart = null;
let curModelIdx = 0;

function buildTabs() {
  const wrap = document.getElementById('modelTabs');
  wrap.innerHTML = MODELS.map((m, i) =>
    `<button onclick="selectModel(${i})" id="mdltab-${i}"
      style="padding:7px 14px;border-radius:20px;border:1px solid ${i===0?'var(--accent)':'var(--border)'};
      background:${i===0?'var(--accent)':'none'};color:${i===0?'#fff':'var(--text2)'};
      font-size:12px;cursor:pointer;transition:all .15s;white-space:nowrap">
      ${m.name}
      <span style="font-size:10px;opacity:.75;margin-left:4px">${m.totalPCS.toLocaleString('en-IN')} pcs</span>
    </button>`
  ).join('');
}

function selectModel(idx) {
  curModelIdx = idx;
  const m = MODELS[idx];
  if (!m) return;

  // Update tab styles
  MODELS.forEach((_, i) => {
    const btn = document.getElementById('mdltab-' + i);
    if (!btn) return;
    btn.style.background   = i===idx ? 'var(--accent)' : 'none';
    btn.style.color        = i===idx ? '#fff'           : 'var(--text2)';
    btn.style.borderColor  = i===idx ? 'var(--accent)'  : 'var(--border)';
  });

  // Header info
  document.getElementById('deepModelName').textContent = m.name;
  document.getElementById('deepModelSub').textContent  =
    m.skus.length + ' flavours · ' + m.totalPCS.toLocaleString('en-IN') + ' pcs total';

  // Stats strip
  const topSku = m.skus[0];
  const statsEl = document.getElementById('pieStats');
  statsEl.innerHTML = [
    { label:'Flavours', val: m.skus.length },
    { label:'Top Flavour', val: topSku ? topSku.sku : '—' },
    { label:'Top PCS', val: topSku ? topSku.pcs.toLocaleString('en-IN') : '—' },
  ].map(s => `<div style="flex:1;padding:10px 12px;text-align:center;border-right:1px solid var(--border)">
    <div style="font-size:10px;color:var(--text2);margin-bottom:4px">${s.label}</div>
    <div style="font-size:13px;font-weight:700;color:var(--text)">${s.val}</div>
  </div>`).join('').replace(/border-right:1px solid var\(--border\)(?="><\/div>\s*$)/, '');
  // Remove last right border
  statsEl.innerHTML = statsEl.innerHTML.replace(
    /(border-right:1px solid var\(--border\))(?=[^>]*><\/div>\s*$)/,
    ''
  );

  // Update pie chart
  const labels = m.skus.map(s => s.sku);
  const data   = m.skus.map(s => s.pcs);
  const colors = PALETTE.slice(0, m.skus.length);

  if (pieChart) {
    pieChart.data.labels                      = labels;
    pieChart.data.datasets[0].data            = data;
    pieChart.data.datasets[0].backgroundColor = colors;
    pieChart.update();
  } else {
    pieChart = new Chart(document.getElementById('skuPie'), {
      type: 'doughnut',
      data: { labels, datasets:[{ data, backgroundColor:colors, borderWidth:2, borderColor:'var(--card)', hoverOffset:8 }] },
      options: {
        responsive:true, maintainAspectRatio:false, cutout:'58%',
        plugins: {
          legend:{ display:false },
          tooltip:{ callbacks:{
            label: ctx => ' ' + ctx.label + ': ' + ctx.raw.toLocaleString('en-IN') + ' pcs',
            afterLabel: ctx => {
              const tot = ctx.dataset.data.reduce((a,v)=>a+v,0);
              return ' ' + (tot>0?((ctx.raw/tot)*100).toFixed(1):'0') + '% of model';
            }
          }}
        }
      }
    });
  }

  // Render flavour table
  renderFlavourTable(m);
  const inp = document.getElementById('flavourSearch');
  if (inp) inp.value = '';
}

function renderFlavourTable(m) {
  const tv = m.totalPCS || 1;
  const rows = m.skus.map((s, i) => {
    const pct = tv > 0 ? ((s.pcs / tv) * 100).toFixed(1) : '0.0';
    const w   = Math.min(100, parseFloat(pct));
    const clr = PALETTE[i % PALETTE.length];
    return `<tr class="frow" data-name="${s.sku.toLowerCase()}">
      <td style="color:var(--text2);font-size:12px">${i+1}</td>
      <td><div style="width:10px;height:10px;border-radius:50%;background:${clr}"></div></td>
      <td style="font-weight:600;font-size:13px">${s.sku}</td>
      <td style="text-align:right;font-weight:700;font-size:15px;color:var(--accent2)">${s.pcs.toLocaleString('en-IN')}</td>
      <td style="text-align:right">
        <div style="display:flex;align-items:center;justify-content:flex-end;gap:8px">
          <div style="width:80px;height:6px;background:var(--bg3);border-radius:3px">
            <div style="height:6px;border-radius:3px;background:${clr};width:${w}%"></div>
          </div>
          <span style="font-size:12px;color:var(--text2);min-width:42px;text-align:right">${pct}%</span>
        </div>
      </td>
    </tr>`;
  }).join('');
  document.getElementById('flavourBody').innerHTML = rows;
}

function filterFlavours(q) {
  const lq = q.toLowerCase().trim();
  document.querySelectorAll('#flavourBody .frow').forEach(r => {
    r.style.display = !lq || r.dataset.name.includes(lq) ? '' : 'none';
  });
}

// ── Boot ─────────────────────────────────────────────────
if (MODELS.length > 0) {
  buildTabs();
  selectModel(0);
}
</script>

<%- include('partials/foot') %>
